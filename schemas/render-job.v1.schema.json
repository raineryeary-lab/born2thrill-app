{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://born2thrill.de/schemas/render-job.v1.schema.json",
  "title": "ZuhauseFinder effective render contract v1",
  "type": "object",
  "required": ["schema", "policy_version", "job_id", "plan_id", "inputs", "references", "protected_invariants", "required_outputs", "contract_sha256"],
  "properties": {
    "schema": {"const": "zf-effective-render-contract-v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1},
    "references": {"type": "array"},
    "protected_invariants": {"type": "object"},
    "required_outputs": {"type": "array", "minItems": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
