/** POST mit Frist. Liefert immer ein Objekt: die JSON-Antwort, oder
 *  {ok:false, error} mit lesbarem Grund -- auch bei HTTP-Fehler, HTML statt
 *  JSON oder Zeitueberschreitung (ZUVERLAESSIGKEIT-001, B5). Vorher hing ein
 *  Knopf ohne Antwort ewig auf "laedt …", und eine HTML-Fehlerseite wurde
 *  zu einem unverstaendlichen SyntaxError. */
async function postJson(pfad: string, koerper: unknown, fristMs = 60_000): Promise<any> {
  try {
    const antwort = await fetch(pfad, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(koerper),
      signal: AbortSignal.timeout(fristMs),
    });
    const text = await antwort.text();
    let daten: any = null;
    try { daten = text ? JSON.parse(text) : null; } catch { daten = null; }
    if (!antwort.ok) {
      return { ...(daten && typeof daten === "object" ? daten : {}), ok: false,
               error: daten?.error || `HTTP ${antwort.status}: ${text.slice(0, 300)}` };
    }
    if (!daten || typeof daten !== "object") {
      return { ok: false, error: `Antwort ohne JSON (HTTP ${antwort.status}): ${text.slice(0, 300)}` };
    }
    return daten;
  } catch (fehler: any) {
    if (fehler?.name === "TimeoutError" || fehler?.name === "AbortError") {
      const minuten = Math.round(fristMs / 60_000);
      return { ok: false, zeitueberschreitung: true,
               error: `Keine Antwort nach ${minuten >= 1 ? `${minuten} min` : `${Math.round(fristMs / 1000)} s`}. `
                 + "Ob es auf dem Server geklappt hat, ist offen -- er arbeitet womöglich "
                 + "noch weiter. Nicht sofort erneut klicken: erst nachsehen (Bilder-Tab, Hausliste)." };
    }
    return { ok: false, error: String(fehler?.message || fehler) };
  }
}

/** Eine Zeile im Tab "Hochladen & Freigeben": was gemacht ist, was fehlt. */
function LieferZeile({ eintrag }: { eintrag: { stand: string; text: string; detail?: string } }) {
  // Offene Staende stehen schon auf dem Knopf; hier nur noch die Einzelheit.
  const aufKnopf = ["offen", "teilweise", "gesperrt"].includes(eintrag.stand);
  if (aufKnopf && !eintrag.detail) return null;
  return (
    <p className="lieferzeile">
      {!aufKnopf && <span className={eintrag.stand === "erledigt" ? "erledigt" : ""}>
        {eintrag.stand === "erledigt" ? "✓ " : ""}{eintrag.text}</span>}
      {!aufKnopf && eintrag.detail ? " · " : ""}{eintrag.detail}
    </p>
  );
}

