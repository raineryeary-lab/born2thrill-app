			if (!budget.value && !art.value && !zi.value && !du.value) return true;
			if (!w) return false;
			if (art.value && w[0] !== art.value) return false;
			if (zi.value && String(w[1]) !== zi.value) return false;
			if (du.value && String(w[3]) !== du.value) return false;
