			FELDER.forEach(function (feld) {
				feld[1].forEach(function (z) {
					var n = [0, 0, 0];
					D.forEach(function (h) {
						if (h[0] === feld[0] && Math.min(Math.floor(h[2]), 5) === z) n[spalte(preis(h, f))]++;
