		var erkl = box.querySelector('.gk-pt-erkl'), tbody = box.querySelector('tbody');
		function zeichne() {
			var f = Number(regler.value);
			wert.textContent = heute ? 'heute' : komma(f);
			box.querySelectorAll('button').forEach(function (k) {
				k.setAttribute('aria-pressed', String(heute ? !!k.dataset.heute : !k.dataset.heute && Number(k.dataset.f) === f));
			});
			erkl.textContent = heute
				? 'Heute: 3.000 € je m² gezeichneter Fläche für jeden Haustyp.'
				: 'Faktor ' + komma(f) + ': ' + (f === 1 ? 'reiner Marktpreis' : Math.round((f - 1) * 100) + ' % über dem Markt') + '.';
