add_action( 'wp_footer', function () {
	if ( is_admin() || ! current_user_can( 'edit_posts' ) ) {
		return;
	}
	$post = get_post();
	if ( ! $post || ! has_shortcode( $post->post_content, 'grundriss_katalog' ) ) {
		return;
	}
