# Public app URL used for auth redirects and canonical links.
NEXT_PUBLIC_SITE_URL=
ZUHAUSEFINDER_WEBHOOK_TOKEN=

# Railway PostgreSQL.
# Set this in Railway from the PostgreSQL service reference, not in Git.
DATABASE_URL=

# Object storage for large training uploads.
# Recommended interim provider: Cloudflare R2 or any S3-compatible bucket.
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Supabase compatibility variables.
# Keep these only while Auth still runs through Supabase.
# Upload storage should use OBJECT_STORAGE_* instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
