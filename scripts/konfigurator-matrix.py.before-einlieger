"""Konfigurator-Matrix: welche der 10 Grundriss-Felder haben wir, welche fehlen?

Seit 2026-11-03 gilt der Fragebogen "Hausbau-Konfigurator – Fragen & Ablauf"
(docs/Hausbau-Konfigurator-Fragen-Ablauf.pdf, REGELN 37):

    EFH 4/5   DHH 4/5   Bungalow 3/4/5   ZFH 3/4/5   (Zimmer ohne Kueche, Bad)

Preis je Zimmerzahl (Chef, 2026-11-05, ersetzt die drei Budgetstufen):
    3 Zimmer 450-500 Tsd.   4 Zimmer 480-550 Tsd.   5 Zimmer 550-650 Tsd.
Ein Haus fuellt sein Feld nur, wenn sein Preis im Fenster seiner Zimmerzahl
liegt; sonst steht in der Spalte budget "zu guenstig" oder "zu teuer".

dazu Frage 8 "Gaeste-WC mit Dusche" (Spalte gaeste_wc_dusche). Die oberste
Stufe heisst "5+": ein 6-Zimmer-Haus zaehlt dort. Ein Haus unter 300 Tsd.
zaehlt im untersten Budget. Die alte Excel-Fassung (31 Felder) steht unten
nur noch als Herkunft.

Rainer, 2026-10-16: "we basically check all the houses we got for biggest to
smallest and have some kind of variable in the backend that basically gives
the price per m2" -- und: "we use our annotated values". Die annotierten
Haeuser sind die Lehrbasis; spaeter werden daraus Grundrisse je Preisklasse
optimiert.

Quelle der 31 Felder: G:\\Meine Ablage\\_handoff\\Hausbauvarianten KS
Konfigurator.xlsx ("31 Grundrisse je Innen-Einrichtung M/K + 26 Ansichten").

    Budget bis 450   EFH 4/5/+   DHH 3/4/+     Bungalow 3/4/5/+
    Budget bis 600   EFH 4/5/+   DHH 3/4/5/+   Bungalow 3/4/+    ZFH 3/4/+
    Budget ueber 600 EFH 5/+                   Bungalow 3/4/+    ZFH 3/4/+

"+" ist die naechste Stufe und alles darueber (EFH 4/5/+ = 4, 5, 6+).

Je Haus:
  - Wohnflaeche aus den ANNOTIERTEN Raumpolygonen (ohne Garage, Carport,
    Terrasse, Balkon, Loggia, Keller) -- keine Korrektur auf Katalogwerte.
  - Preis = Wohnflaeche x Preis je m2 aus konfigurator.json (eine Zahl,
    im Backend aenderbar). Daraus die Budgetklasse.
  - Zimmerzahl wie in der Excel ("Kue, Bad, WC + 3R, 4R, 5R"): Wohn- und
    Schlafraeume; ein offenes Wohnen/Essen/Kochen zaehlt als 1. Kueche, Bad,
    WC, HWR, Diele, Flur, Abstell, Ankleide zaehlen nicht.
  - Haustyp: bungalow_* und *_bungalow_* -> bungalow; twostorey_*,
    onehalfstorey_* -> efh. DHH und ZFH kennt der Bestand nicht.

Ausgabe: konfigurator-matrix.csv (alle Haeuser) und konfigurator-fehlt.md
(die Felder und was fehlt) im Workbench-Datenordner.
"""

import csv
import json
import math
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import hausdaten  # noqa: E402  eine Vorrangregel fuer Bau, Liste und Matrix

HERE = os.path.dirname(os.path.abspath(__file__))
PROJECTS = os.path.abspath(os.path.join(HERE, "..", "..", "floorplan-simplifier", "projects"))
DATA = os.environ.get("FLOORPLAN_WORKBENCH_DATA_DIR")
if not DATA:
    sys.exit("FLOORPLAN_WORKBENCH_DATA_DIR ist nicht gesetzt -- siehe .env.local.")

KONFIG = os.path.join(DATA, "konfigurator.json")
# Die Backend-Einstellungen. Fehlt ein Schluessel in konfigurator.json, gilt
# der Standard hier -- er folgt der ueblichen Zaehlung der Immobilienportale:
# Wohn-, Schlaf-, Kinder-, Arbeitszimmer zaehlen; Kueche, Bad, WC, Flur,
# Abstellraum nicht; eine Wohnkueche bzw. ein offenes Wohnen/Essen/Kochen ist
# EIN Zimmer; kleine Raeume zaehlen halb.
STANDARD = {
    "preis_pro_m2": 3000,
    "offener_wohnbereich_zaehlt": 1,     # Wohnen/Essen/Kochen in einem Raum
    "zimmer_mindestflaeche_m2": 6,       # darunter kein Zimmer
    # kleine-zimmer-v1 (Rainer, 2026-11-07): keine halben Zimmer mehr -- 2,5
    # Zimmer fanden sich unter keinem Filter. 0 = jedes Zimmer ab 6 m2 zaehlt voll.
    "halbes_zimmer_unter_m2": 0,
    # Zimmer unter dieser Flaeche stehen in der Spalte kleine_zimmer und sind auf
    # /haus gruen, bis Rainer "Zimmer geprueft" klickt.
    "kleines_zimmer_pruefen_unter_m2": 10,
    "halbe_zimmer_runden": "ab",         # "ab": 4,5 -> Stufe 4; "auf": 4,5 -> Stufe 5
    # Preisfenster je Zimmerstufe in EUR (Chef, 2026-11-05).
    "preisfenster": {"3": [450_000, 500_000], "4": [480_000, 550_000], "5": [550_000, 650_000]},
    # Zwei Grenzen (m2 Aussenumriss, alle Geschosse) fuer 3 Groessenklassen.
    # null = beim Lauf als Drittel nach Anzahl vorschlagen und hier eintragen.
    "groessenklassen_grenzen_m2": None,
    "_hinweis": "Werte aendern und konfigurator-matrix.py neu laufen lassen.",
}

# haustyp -> Zimmerstufen; die letzte Stufe heisst "n+". 10 Felder.
ZIMMERSTUFEN = {"efh": [4, 5], "dhh": [4, 5], "bungalow": [3, 4, 5], "zfh": [3, 4, 5]}
FELDER = dict(ZIMMERSTUFEN)

NICHT_WOHNFLAECHE = ("garage", "carport", "terrasse", "balkon", "loggia", "keller")
KEIN_ZIMMER = ("bad", "wc", "dusch", "hwr", "htr", "hauswirtschaft", "diele", "flur",
               "abstell", "speis", "ankleide", "technik", "garage", "carport", "terrasse",
               "balkon", "loggia", "keller", "treppe", "luftraum", "galerie")
ZIMMER = ("wohnen", "wohnzimmer", "schlafen", "eltern", "kind", "buero", "büro", "arbeit",
          "gast", "zimmer", "essen")


EFH_TYPEN = ("twostorey", "onehalfstorey", "twostorey_cellar", "2-storey", "1.5-storey")


def zeichnung(plan):
    try:
        with open(os.path.join(PROJECTS, plan, "annotations.json"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def haustyp(plan, d=None):
    # Ein Ober- oder Dachgeschoss oder eine Treppe in der Zeichnung macht nie
    # einen Bungalow, egal was gespeichert ist (Rainer, 2026-11-07,
    # bungalow_034 und bungalow_generationat: "Both are EFH"; "if there are
    # stairs its not a bungalow"). data.json bleibt, wie es ist.
    typ = haustyp_gespeichert(plan, d)
    # wohneinheiten-zfh-mfh-v1 (Rainer, 2026-11-07): 2 Wohnungen = ZFH,
    # 3+ = MFH. Die Doppelhaushaelfte bleibt, was sie ist.
    d = zeichnung(plan) if d is None else d
    we = wohneinheiten_von(d)
    if typ != "dhh" and we >= 3:
        return "mfh"
    if typ != "dhh" and we == 2:
        return "zfh"
    if typ != "bungalow":
        return typ
    ebenen = {a.get("floor_level") for a in (d.get("annotations") or []) if a.get("floor_level")}
    treppe = any(e.get("type") == "stairs" for e in (d.get("elements") or []))
    return "efh" if treppe or ebenen & {"upperfloor", "attic"} else typ


def wohneinheiten_von(d):
    try:
        return max(1, int((d or {}).get("wohneinheiten") or 1))
    except (TypeError, ValueError):
        return 1


def haustyp_gespeichert(plan, d=None):
    # Zuerst die Zeichnung, dann data.json -- die Projekt-ID kann luegen
    # (bungalow_040_185 und bungalow_xvv6 sind Zweigeschosser). Eine
    # Doppelhaushaelfte traegt `doppelhaus: {"trennwand": ...}` in der
    # Zeichnung (doppelhaushaelfte-v1); bis 2026-11-03 zaehlte sie als EFH.
    # annotator-preisrechner-v1: die ungespeicherte Zeichnung geht vor.
    if d is not None:
        if d.get("doppelhaus"):
            return "dhh"
        if d.get("house_type") == "bungalow":
            return "bungalow"
        if d.get("house_type") in EFH_TYPEN:
            return "efh"
    for name in ("annotations.json", "data.json"):
        try:
            with open(os.path.join(PROJECTS, plan, name), encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        if d.get("doppelhaus"):
            return "dhh"
        typ = d.get("house_type")
        if typ == "bungalow":
            return "bungalow"
        if typ in EFH_TYPEN:
            return "efh"
    if plan.startswith("bungalow_") or "_bungalow_" in plan:
        return "bungalow"
    if plan.startswith(("twostorey_", "onehalfstorey_")) or "_onehalfstorey_" in plan or "_twostorey_" in plan:
        return "efh"
    return None


def label_reparieren(label):
    """Doppelt/einfach falsch kodierte Umlaute zurueck ("BÃƒÂ¼ro" -> "Büro").

    zimmer-zaehlung-v1 (Codex + Claude, 2026-11-07): ein kaputtes Büro-Label in
    german_catalog_review_twostorey_5_6_1_sv_195 zaehlte nicht als Zimmer.
    """
    text = str(label or "")
    for _ in range(3):
        if "Ã" not in text:
            break
        try:
            text = text.encode("cp1252").decode("utf-8")
        except (UnicodeEncodeError, UnicodeDecodeError):
            break
    return text


NASSRAUM = ("bad", "wc", "dusch")


def ist_zimmer(label):
    text = label_reparieren(label).lower()
    # Nassraeume zaehlen nie, auch nicht "Kinderbad" (zimmer-zaehlung-v1: das
    # "kind" darin hob den Ausschluss auf, 8 Haeuser zaehlten ein Bad mit).
    if any(k in text for k in NASSRAUM):
        return False
    if any(k in text for k in KEIN_ZIMMER) and not any(k in text for k in ("wohnen", "schlafen", "kind")):
        return False
    return any(k in text for k in ZIMMER)


def ist_dusch_wc(label):
    # Frage 8 "Gaeste-WC mit Dusche": in den Zeichnungen heisst er DU-WC.
    text = (label or "").lower().replace(" ", "")
    return text in ("du-wc", "du/wc", "duwc") or ("wc" in text and "dusch" in text)


def flaeche(punkte):
    return abs(sum(punkte[i]["x"] * punkte[(i + 1) % len(punkte)]["y"]
                   - punkte[(i + 1) % len(punkte)]["x"] * punkte[i]["y"]
                   for i in range(len(punkte)))) / 2


def bildverhaeltnis(projekt, ebene, annotationen):
    try:
        from PIL import Image
    except ImportError:
        Image = None
    for name in (f"{ebene}_original_preview.png", "original_preview.png"):
        pfad = os.path.join(projekt, name)
        if Image and os.path.exists(pfad):
            w, h = Image.open(pfad).size
            return h / w
    raum = (annotationen.get("annotation_space") or {}).get("aspect")
    return float(raum) if raum else None


def umriss_flaeche(projekt, d, raeume, skalen):
    """Summe der Aussenumrisse aller Geschosse mit Raeumen, in m2.

    umriss-groesse-drei-klassen-v1. Rainer, 2026-11-07: "use the Aussenumriss
    from each floor, add everything up" -- die Geschosshoehe ist ueberall
    gleich, also ist die Flaeche das Mass fuer den umbauten Raum. Ein Geschoss
    ohne eigenen Umriss nimmt den gezeichneten (outlineForFloor() in
    annotate.js; Rainer: bei gleichen Geschossen reicht der EG-Umriss). Ein
    Staffelgeschoss ist kleiner und wird nie kopiert.
    Gibt (m2 oder None, Hinweis) zurueck.
    """
    eigene = {}
    je = d.get("outer_outlines")
    if isinstance(je, dict):
        eigene = {k: v for k, v in je.items() if isinstance(v, list) and len(v) >= 3}
    if not eigene and len(d.get("outer_outline") or []) >= 3:
        eigene = {d.get("outer_outline_floor") or "groundfloor": d["outer_outline"]}
    if not eigene:
        return None, "kein Außenumriss"

    def m2(ebene, punkte):
        s = skalen.get(ebene) or next(iter(skalen.values()))
        v = bildverhaeltnis(projekt, ebene, d)
        return flaeche(punkte) * s * s * v if v else None

    eigen_m2 = {k: m2(k, v) for k, v in eigene.items()}
    if any(v is None for v in eigen_m2.values()):
        return None, "kein Seitenverhältnis"
    # Umriss kleiner als die Haelfte der Raeume seines Geschosses: Versehen
    # (bungalow_040_17, 2026-11-07: ein 1 x 8 px Rechteck). Wie umrissFehlt()
    # in hausdaten.mjs, im normierten Bild verglichen.
    zu_klein = sorted(k for k, v in eigene.items()
                      if (r := sum(flaeche(a["points"]) for a in raeume if a.get("floor_level") == k)) > 0
                      and flaeche(v) < 0.5 * r)
    if zu_klein:
        return None, "Außenumriss zu klein: " + ", ".join(zu_klein)
    # Quelle fuer Geschosse ohne eigenen Umriss: wie outlineForFloor() der
    # erste gezeichnete -- bevorzugt das Erdgeschoss.
    quelle = "groundfloor" if "groundfloor" in eigen_m2 else next(iter(eigen_m2))
    summe, fehlt = 0.0, []
    for ebene in sorted({a.get("floor_level") for a in raeume if a.get("floor_level")}):
        if ebene in eigen_m2:
            summe += eigen_m2[ebene]
        elif "staffel" in ebene.lower():
            fehlt.append(ebene)
        else:
            summe += eigen_m2[quelle]
    if fehlt:
        return None, "Umriss fehlt: " + ", ".join(fehlt)
    return round(summe), ""


# umbauter-raum-volumen-v1 (Rainer, 2026-11-07: "make a second slider with the
# volume please"). Hoehen wie im Bau: Geschoss 2,62 m (2,40 Wand + 0,22 Decke),
# 1,5-Geschosser Kniestock 1,0 m bei 40 Grad (anderthalb.py).
GESCHOSS_M = 2.62
KNIESTOCK_M = 1.0
DACHNEIGUNG_GRAD = 40.0


def nutzhoehe_dach(spannweite_m):
    """Mittlere Raumhoehe unter einem Satteldach: an beiden Traufen 1,0 m,
    steigt mit 40 Grad, gedeckelt bei 2,62 m (der Spitzboden zaehlt nicht)."""
    import math
    b = float(spannweite_m)
    if b <= 0:
        return 0.0
    t = math.tan(math.radians(DACHNEIGUNG_GRAD))
    x0 = (GESCHOSS_M - KNIESTOCK_M) / t          # ab hier ist die volle Hoehe erreicht
    halb = b / 2
    if halb <= x0:
        flaeche = 2 * (KNIESTOCK_M * halb + t * halb * halb / 2)
    else:
        flaeche = 2 * (KNIESTOCK_M * x0 + t * x0 * x0 / 2) + (b - 2 * x0) * GESCHOSS_M
    return flaeche / b


def ist_anderthalb(plan, d):
    if "onehalfstorey" in plan or "1_5" in plan:
        return True
    return str((d or {}).get("house_type") or "").startswith("1.5")


def umbauter_raum(projekt, d, raeume, skalen):
    """Volumen in m3 (oder None): volle Geschosse Umriss x 2,62 m, Dachgeschoss
    und oberes Geschoss eines 1,5-Geschossers Umriss x nutzhoehe_dach(kurze
    Seite des Umrisses). Geschosse ohne eigenen Umriss wie in umriss_flaeche()."""
    eigene = {}
    je = d.get("outer_outlines")
    if isinstance(je, dict):
        eigene = {k: v for k, v in je.items() if isinstance(v, list) and len(v) >= 3}
    if not eigene and len(d.get("outer_outline") or []) >= 3:
        eigene = {d.get("outer_outline_floor") or "groundfloor": d["outer_outline"]}
    if not eigene:
        return None

    def mass(ebene, punkte):
        s = skalen.get(ebene) or next(iter(skalen.values()))
        v = bildverhaeltnis(projekt, ebene, d)
        if not v:
            return None
        xs = [p["x"] * s for p in punkte]
        ys = [p["y"] * s * v for p in punkte]
        return flaeche(punkte) * s * s * v, min(max(xs) - min(xs), max(ys) - min(ys))

    je_ebene = {k: mass(k, v) for k, v in eigene.items()}
    if any(v is None for v in je_ebene.values()):
        return None
    quelle = "groundfloor" if "groundfloor" in je_ebene else next(iter(je_ebene))
    ebenen = sorted({a.get("floor_level") for a in raeume if a.get("floor_level")})
    ueber_erde = [e for e in ebenen if e != "basement"]
    anderthalb_oben = ueber_erde[-1] if ist_anderthalb(os.path.basename(projekt), d) and len(ueber_erde) >= 2 else None
    summe = 0.0
    for ebene in ebenen:
        if ebene in je_ebene:
            m2, kurz = je_ebene[ebene]
        elif "staffel" in ebene.lower():
            return None
        else:
            m2, kurz = je_ebene[quelle]
        unter_dach = ebene == "attic" or ebene == anderthalb_oben
        summe += m2 * (nutzhoehe_dach(kurz) if unter_dach else GESCHOSS_M)
    return round(summe)


def drittel_grenzen(werte):
    """Erster Vorschlag fuer die zwei Klassengrenzen: Drittel nach Anzahl."""
    w = sorted(werte)
    if len(w) < 3:
        return None
    return [w[len(w) // 3], w[2 * len(w) // 3]]


def groessenklasse(m2, grenzen):
    """1 klein, 2 mittel, 3 gross -- oder None ohne Umriss."""
    if m2 is None or not grenzen:
        return None
    return 1 if m2 < grenzen[0] else 2 if m2 < grenzen[1] else 3


def haus_werte(plan, d=None):
    """Werte eines Hauses aus annotations.json -- oder aus d, der noch
    ungespeicherten Zeichnung im Annotator (annotator-preisrechner-v1)."""
    projekt = os.path.join(PROJECTS, plan)
    live = d is not None
    if not live:
        pfad = os.path.join(projekt, "annotations.json")
        if not os.path.exists(pfad):
            return None
        with open(pfad, encoding="utf-8") as f:
            d = json.load(f)
    raeume = [a for a in d.get("annotations") or [] if (a.get("points") or []) and len(a["points"]) >= 3]
    if not raeume:
        return None
    # Massstab UND Seitenverhaeltnis wie der Bau: annotations.json vor
    # gebaeudemass.json, je Feld (scripts/hausdaten.py). "Gebaeudemasse
    # eingeben" schreibt ins Sidecar -- ohne das kamen eingetippte Masse nie
    # in die Website-Filter (matrix-gebaeudemass-v1, 2026-11-05).
    gemischt = hausdaten.hausdaten(projekt)
    skalen = gemischt["floor_scale"] or {}
    if live:
        skalen = {**skalen, **{k: v for k, v in (d.get("floor_scale") or {}).items() if v}}
    d = dict(d, annotation_space=gemischt["annotation_space"])
    if not skalen:
        return {"plan": plan, "fehlt": "kein Massstab"}
    qm = 0.0
    luftraum = 0.0
    for a in raeume:
        ebene = a.get("floor_level")
        s = skalen.get(ebene) or next(iter(skalen.values()))
        if any(k in (a.get("label") or "").lower() for k in NICHT_WOHNFLAECHE):
            continue
        v = bildverhaeltnis(projekt, ebene, d)
        if not v:
            return {"plan": plan, "fehlt": "kein Seitenverhaeltnis"}
        stueck = flaeche(a["points"]) * s * s * v
        # Luftraum zaehlt voll mit -- er ist umbauter Raum und macht das Haus
        # groesser und teurer. Rainer, 2026-10-16: "just count it as if it
        # were quadratmeter, it is an umbauter Raum". Ausgewiesen wird er
        # trotzdem getrennt, damit man sieht, wieviel davon kein Boden ist.
        if "luftraum" in (a.get("label") or "").lower():
            luftraum += stueck
        qm += stueck
    # Ein Raum aus mehreren Polygonen (connected_room_id) ist EIN Zimmer --
    # seine Flaeche ist die Summe der Teile.
    flaechen = {}
    for a in raeume:
        if not ist_zimmer(a.get("label")):
            continue
        schluessel = a.get("connected_room_id") or a.get("id")
        ebene = a.get("floor_level")
        s = skalen.get(ebene) or next(iter(skalen.values()))
        eintrag = flaechen.setdefault(schluessel, {"m2": 0.0, "label": a.get("label") or ""})
        eintrag["m2"] += flaeche(a["points"]) * s * s * bildverhaeltnis(projekt, ebene, d)
    zimmer = 0.0
    kleine = []
    for e in flaechen.values():
        offen = "wohnen" in e["label"].lower() and any(
            k in e["label"].lower() for k in ("essen", "kochen", "kueche", "küche"))
        if offen:
            zimmer += float(EINST["offener_wohnbereich_zaehlt"])
            continue
        if e["m2"] < EINST["zimmer_mindestflaeche_m2"]:
            continue
        # kleine-zimmer-v1: zur Pruefung auf /haus (gruen), zaehlt trotzdem.
        if round(e["m2"], 1) < EINST["kleines_zimmer_pruefen_unter_m2"]:  # wie angezeigt (bungalow_037)
            kleine.append(f"{label_reparieren(e['label'])} {e['m2']:.1f} m²".replace(".", ","))
        zimmer += 0.5 if e["m2"] < EINST["halbes_zimmer_unter_m2"] else 1
    umriss_m2, umriss_fehlt = umriss_flaeche(projekt, d, raeume, skalen)
    volumen_m3 = umbauter_raum(projekt, d, raeume, skalen) if umriss_m2 is not None else None
    return {"plan": plan, "qm": round(qm), "luftraum": round(luftraum), "zimmer": zimmer,
            "kleine_zimmer": " · ".join(sorted(kleine)),
            "wohneinheiten": wohneinheiten_von(d),
            "umriss_m2": umriss_m2, "umriss_fehlt": umriss_fehlt, "volumen_m3": volumen_m3,
            "haustyp": haustyp(plan, d if live else None),
            "dusch_wc": any(ist_dusch_wc(a.get("label")) for a in raeume)}


def budget_fuer(preis, stufe):
    """'passt', 'zu guenstig' oder 'zu teuer' fuer das Preisfenster der Zimmerstufe."""
    fenster = EINST["preisfenster"].get(str(stufe)) if stufe is not None else None
    if not fenster:
        return ""
    if preis < fenster[0]:
        return "zu guenstig"
    if preis > fenster[1]:
        return "zu teuer"
    return "passt"


def stufe_fuer(zimmer, stufen):
    zimmer = (math.ceil(zimmer) if EINST["halbe_zimmer_runden"] == "auf" else math.floor(zimmer))
    if zimmer >= stufen[-1]:
        return stufen[-1]
    return zimmer if zimmer in stufen else None


def stufen_name(stufe, stufen):
    return f"{stufe}+" if stufe == stufen[-1] else str(stufe)


EINST = dict(STANDARD)


# annotator-preisrechner-v1: dieselben Saetze wie Preistabelle (Snippet 12) und
# Chefseite. Marktsatz je m2 Wohnflaeche, Wohnflaeche = gezeichnet x 0,8.
SATZ = {"B": 2700, "A": 2500, "Z": 2650}
WOHNFLAECHE_ANTEIL = 0.8
FAKTOR = 1.3
EUR_M3 = 1080


def einstellungen_laden():
    """konfigurator.json in EINST lesen, ohne die Datei zu schreiben."""
    EINST.clear()
    EINST.update(STANDARD)
    if os.path.exists(KONFIG):
        with open(KONFIG, encoding="utf-8") as f:
            EINST.update(json.load(f))


def satztyp(plan, d, typ):
    """B Bungalow, A 1,5-Geschosser, Z sonst (wie satztyp() in der Preistabelle)."""
    if typ == "bungalow":
        return "B"
    ebenen = {a.get("floor_level") for a in (d.get("annotations") or [])}
    if ist_anderthalb(plan, d) or ("attic" in ebenen and "upperfloor" not in ebenen):
        return "A"
    return "Z"


def budgetspalte(preis):
    return "bis 450.000 €" if preis < 450_000 else "450.000–600.000 €" if preis < 600_000 else "über 600.000 €"


def vorschau(plan, d):
    """Was die Matrix fuer die aktuelle Zeichnung ausrechnen wuerde. Schreibt nichts."""
    einstellungen_laden()
    w = haus_werte(plan, d)
    if not w:
        return {"fehlt": "keine Räume gezeichnet"}
    if w.get("fehlt"):
        return {"fehlt": w["fehlt"]}
    typ = w["haustyp"]
    heute = round(w["qm"] * float(EINST["preis_pro_m2"]))
    stufen = FELDER.get(typ)
    stufe = stufe_fuer(w["zimmer"], stufen) if stufen else None
    budget = budget_fuer(heute, stufe)
    t = satztyp(plan, d, typ)
    markt = round(w["qm"] * WOHNFLAECHE_ANTEIL * SATZ[t] * FAKTOR)
    volumen = w.get("volumen_m3")
    preise = [{"name": "heute", "satz": f"{int(EINST['preis_pro_m2'])} €/m² gezeichnet", "preis": heute},
              {"name": "Markt × 1,3", "satz": f"{round(SATZ[t] * FAKTOR)} €/m² Wohnfläche", "preis": markt}]
    if volumen:
        preise.append({"name": "Volumen", "satz": f"{EUR_M3} €/m³", "preis": round(volumen * EUR_M3)})
    for p in preise:
        p["spalte"] = budgetspalte(p["preis"])
    return {"haustyp": typ, "satztyp": t, "qm": w["qm"], "luftraum": w["luftraum"],
            "wohnflaeche": round(w["qm"] * WOHNFLAECHE_ANTEIL), "zimmer": w["zimmer"],
            "kleine_zimmer": w["kleine_zimmer"], "umriss_m2": w["umriss_m2"],
            "umriss_fehlt": w["umriss_fehlt"], "volumen_m3": volumen,
            "feld": (f"{typ}-{stufen_name(stufe, stufen)}" if stufe is not None else ""),
            "budget": budget, "fenster": EINST["preisfenster"].get(str(stufe)) if stufe is not None else None,
            "preise": preise}


def main():
    konfig = {}
    if os.path.exists(KONFIG):
        with open(KONFIG, encoding="utf-8") as f:
            konfig = json.load(f)
    # Fehlende Schluessel mit dem Standard ergaenzen und zurueckschreiben, damit
    # alle Einstellungen in der Datei sichtbar sind.
    for k, v in STANDARD.items():
        konfig.setdefault(k, v)
    with open(KONFIG, "w", encoding="utf-8") as f:
        json.dump(konfig, f, indent=1)
    EINST.update(konfig)
    preis_m2 = float(EINST["preis_pro_m2"])

    fertig = set()
    ledger = os.path.join(DATA, "fertig-ledger.json")
    if os.path.exists(ledger):
        with open(ledger, encoding="utf-8") as f:
            l = json.load(f)
        fertig = set(l.get("plans", l).keys()) if isinstance(l, dict) else set()

    haeuser = []
    for plan in sorted(os.listdir(PROJECTS)):
        if plan.startswith("_") or not os.path.isdir(os.path.join(PROJECTS, plan)):
            continue
        w = haus_werte(plan)
        if not w or w.get("fehlt") or not w.get("haustyp"):
            continue
        w["preisflaeche"] = w["qm"]   # Luftraum steckt schon voll in qm
        w["preis"] = round(w["preisflaeche"] * preis_m2)
        stufen = FELDER.get(w["haustyp"])
        stufe = stufe_fuer(w["zimmer"], stufen) if stufen else None
        w["budget"] = budget_fuer(w["preis"], stufe)
        w["feld"] = (f"{w['haustyp']}-{stufen_name(stufe, stufen)}"
                     if stufe is not None and w["budget"] == "passt" else "")
        w["fertig"] = plan in fertig
        haeuser.append(w)
    haeuser.sort(key=lambda h: -h["qm"])

    # Drei Groessenklassen aus dem Aussenumriss (umriss-groesse-drei-klassen-v1).
    grenzen = EINST.get("groessenklassen_grenzen_m2")
    if not grenzen:
        grenzen = drittel_grenzen([h["umriss_m2"] for h in haeuser if h["umriss_m2"] is not None])
        if grenzen:
            konfig["groessenklassen_grenzen_m2"] = grenzen
            with open(KONFIG, "w", encoding="utf-8") as f:
                json.dump(konfig, f, indent=1)
    for h in haeuser:
        h["klasse"] = groessenklasse(h["umriss_m2"], grenzen)

    with open(os.path.join(DATA, "konfigurator-matrix.csv"), "w", newline="", encoding="utf-8") as f:
        schreiber = csv.writer(f, delimiter=";")
        schreiber.writerow(["plan", "haustyp", "wohnflaeche_m2", "luftraum_m2", "preisflaeche_m2",
                            "zimmer", "preis_eur", "budget", "konfigurator_feld", "fertig",
                            "gaeste_wc_dusche", "umriss_m2", "umriss_fehlt", "groessenklasse",
                            "wohneinheiten", "volumen_m3", "kleine_zimmer"])
        for h in haeuser:
            schreiber.writerow([h["plan"], h["haustyp"], h["qm"], h["luftraum"], h["preisflaeche"],
                                h["zimmer"], h["preis"], h["budget"], h["feld"],
                                "ja" if h["fertig"] else "nein", "ja" if h["dusch_wc"] else "nein",
                                "" if h["umriss_m2"] is None else h["umriss_m2"], h["umriss_fehlt"],
                                h["klasse"] or "", h.get("wohneinheiten", 1),
                                "" if h.get("volumen_m3") is None else h["volumen_m3"], h.get("kleine_zimmer", "")])

    fenster = ", ".join(f"{k} Zi {v[0] // 1000}-{v[1] // 1000}" for k, v in EINST["preisfenster"].items())
    zeilen = [f"# Konfigurator-Matrix ({int(preis_m2)} EUR/m2)", "",
              f"{len(haeuser)} Haeuser mit Massstab ausgewertet, davon {sum(h['fertig'] for h in haeuser)} fertig.",
              f"Preisfenster (Tsd. EUR): {fenster}.",
              f"Ausserhalb des Fensters: {sum(h['budget'] == 'zu guenstig' for h in haeuser)} zu guenstig, "
              f"{sum(h['budget'] == 'zu teuer' for h in haeuser)} zu teuer.", "",
              "| Feld | Status | fertig | offen | fertig mit Dusch-WC |", "|---|---|---|---|---|"]
    fehlt = []
    for typ, stufen in FELDER.items():
        for stufe in stufen:
            name = f"{typ}-{stufen_name(stufe, stufen)}"
            drin = [h for h in haeuser if h["feld"] == name]
            f_ = [h["plan"] for h in drin if h["fertig"]]
            o_ = [h["plan"] for h in drin if not h["fertig"]]
            status = "gruen" if f_ else ("gelb" if o_ else "ROT")
            if not f_ and not o_:
                fehlt.append(name)
            zeilen.append(f"| {name} | {status} | {', '.join(f_[:4])}{' ...' if len(f_) > 4 else ''} "
                          f"| {', '.join(o_[:4])}{' ...' if len(o_) > 4 else ''} "
                          f"| {sum(h['dusch_wc'] for h in drin if h['fertig'])} von {len(f_)} |")
    zeilen += ["", f"## Es fehlen {len(fehlt)} Grundrisse", ""] + [f"- {n}" for n in fehlt]
    if grenzen:
        namen = {1: "klein", 2: "mittel", 3: "gross"}
        zeilen += ["", "## Groessenklassen (Aussenumriss, alle Geschosse)", "",
                   f"Grenzen: unter {grenzen[0]} m2 klein, {grenzen[0]} bis unter {grenzen[1]} m2 mittel, "
                   f"ab {grenzen[1]} m2 gross (konfigurator.json groessenklassen_grenzen_m2).", ""]
        for k in (1, 2, 3):
            drin = sorted((h for h in haeuser if h["klasse"] == k), key=lambda h: h["umriss_m2"])
            zeilen.append(f"- {namen[k]}: {len(drin)} Haeuser, {drin[0]['umriss_m2']}-{drin[-1]['umriss_m2']} m2"
                          if drin else f"- {namen[k]}: 0 Haeuser")
    ohne = [h for h in haeuser if h["umriss_m2"] is None]
    zeilen += ["", f"## Ohne Groesse: {len(ohne)} Haeuser (Aussenumriss zeichnen)", ""]
    zeilen += [f"- {h['plan']}: {h['umriss_fehlt']}" for h in sorted(ohne, key=lambda h: h["plan"])]
    with open(os.path.join(DATA, "konfigurator-fehlt.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(zeilen) + "\n")
    print("\n".join(zeilen))


if __name__ == "__main__":
    main()
