# das ohne gesetzte Variable still auf den alten C:-Nachbarordner
# zurueckfiele, wuerde unbemerkt gegen veraltete Daten arbeiten.
_konfiguriert = os.environ.get("FLOORPLAN_WORKBENCH_DATA_DIR", "").strip()
if not _konfiguriert:
    sys.exit("FLOORPLAN_WORKBENCH_DATA_DIR ist nicht gesetzt -- verweigere, "
            "den Datenordner zu erraten. Siehe .env.local.")
DATA = os.path.abspath(_konfiguriert)

HERO = ("Full frame - 24-35 mm - Stativ - ISO 100 - f/8-f/11, Kamera waagerecht, "
        "3/4-Ansicht der Schokoladenseite, senkrechte Kanten senkrecht, "
        "ganzes Gebaeude im Bild.")


# Das Regelwerk, das jedem Auftrag beiliegt. Eine Datei, eine Wahrheit --
# geaendert wird sie dort, nicht im Generator (Rainer, 2026-08-26).
REGELWERK = os.path.join(os.path.dirname(HERE), "docs", "CODEX-REGELN-4PLUS2.md")
RENDER_POLICY = os.path.join(os.path.dirname(HERE), "policies",
                             "zuhausefinder-hard-rules.v1.json")
REFERENCE_REGISTRY = os.path.join(os.path.dirname(HERE), "references", "index.json")


def _render_contract_module():
    path = os.path.join(HERE, "render-contract.py")
    spec = importlib.util.spec_from_file_location("zf_render_contract", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _json(path):
    with open(path, encoding="utf-8-sig") as handle:
        return json.load(handle)


def compile_render_contract(job, folder):
    module = _render_contract_module()
    policy = _json(RENDER_POLICY)
    registry = _json(REFERENCE_REGISTRY)
    kinds = {item.get("kind") for item in job.get("required_outputs", [])}
    roles = ({"interior-style"} if "interior" in kinds else set())
    if "exterior" in kinds:
        roles.add("exterior-style")
    ids = [item["id"] for item in registry.get("references", [])
           if item.get("approval") == "approved" and item.get("role") in roles]
    return module.compile_contract(job, folder, policy, registry, ids), module


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


# Die vier Innenraum-Stile des Pakets "House Visual Catalog 4+2". Sie gelten
# PRO GESCHOSS, nicht pro Haus (Rainer, 2026-08-26: "4 version per Floor for
# the floorplans and 2 exteriors"). Ein Bungalow ergibt also 4+2 = 6 Bilder,
# ein Zweigeschosser 8+2 = 10.
INNENSTILE = (
