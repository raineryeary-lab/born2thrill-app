# Alles andere im Raum bekommt diese Rolle. Sie ist bewusst anders formuliert
# als "ersetzen": ein Schreibtisch soll stilgerecht neu aussehen und ein
# Schreibtisch bleiben.
MOEBEL_ROLLE = "Moebel (umgestalten, muss sichtbar bleiben)"


# Objekte, die der Bauer aus einem anderen ABLEITET. Sie stehen unter eigenem
# Namen in der .blend und lesen sich im Auftrag wie zusaetzliche Moebel --
# sind es aber nicht: die sechs `essgruppe_stuhl` SIND die Stuehle von
# `essgruppe_6`, nicht sechs weitere.
#
# Rainer, 2026-08-31, zur Lieferung fuer 3_3_4: "look how many chairs ... in
# the dining". Neun Stuehle am Tisch statt sechs. Der Auftrag nannte
# `essgruppe_6-25` "Moebel (muss sichtbar bleiben)" und darunter sechs
# `essgruppe_stuhl` mit derselben Rolle -- also eine Essgruppe fuer sechs UND
# sechs Stuehle.
#
# Der Schluessel ist der abgeleitete Stamm, der Wert der Praefix seines
# Elternteils. `schreibtischstuhl` haengt an JEDEM Objekt, dessen Name mit
# "schreibtisch" beginnt (build-simplifier-render-plan.py:2959), also auch am
# Kinderschreibtisch.
ABGELEITET = {
    "essgruppe_stuhl": "essgruppe_6",
    "schreibtischstuhl": "schreibtisch",
}

# Wie das Paar im Auftrag heissen soll -- die Formulierung, die ein Mensch
# beim Zeichnen im Kopf hat.
PAAR_NAME = {
    "essgruppe_stuhl": "Esstisch mit %d Stuehlen",
    "schreibtischstuhl": "Schreibtisch mit %d Stuhl",
}


def _elternteil(kind_stamm, vorhandene):
    """Der Stamm, von dem `kind_stamm` abgeleitet ist -- oder None."""
    praefix = ABGELEITET.get(kind_stamm)
    if praefix is None:
        return None
    # Exakter Treffer geht vor: `essgruppe_6` ist genau ein Name.
    if praefix in vorhandene:
        return praefix
    passend = sorted(s for s in vorhandene
                     if s.startswith(praefix) and s != kind_stamm)
    return passend[0] if passend else None


def stueckzahlen(objekte, geschoss=None):
    """Wie viele Stuecke von jeder Sorte -- und was davon zusammengehoert.

    Ein Marker je Stueck sagt nur, WO etwas liegt. Wie viele es sind, stand
    bisher nirgends; wer sieben Marker an einem Fleck sieht, malt sieben
    Moebel. Diese Liste sagt die Zahl, und bei abgeleiteten Objekten sagt sie
    dazu, dass sie schon mitgezaehlt sind.
    """
    if not objekte:
        return []
    # GEZAEHLT WIRD DAS MOEBELSTUECK, NICHT DAS NETZ. `objekte` fuehrt jedes
    # Netz einzeln: ein Kleiderschrank besteht aus Korpus, Tueren und
    # Griffen. Ungefiltert stand hier "kleiderschrank: 4", obwohl zwei
    # Schraenke im Haus stehen -- eine Stueckzahl, die MEHR Moebel erfindet
    # als die Namensliste. `_bauteil` fasst dieselben Teile zusammen, genau
    # wie es die Objektkarte fuer die Marker tut.
    stuecke = {stamm: {_bauteil(name) for name in namen}
               for stamm, namen in objekte.items()}
    vorhandene = set(stuecke)
    # Kind -> Elternteil, nur wo beide wirklich in der Datei stehen.
    paare = {}
    for kind in sorted(vorhandene):
        eltern = _elternteil(kind, vorhandene)
        if eltern:
            paare[kind] = eltern

    zeilen = ["", "## Stueckzahlen" + (" (%s)" % geschoss if geschoss else ""), "",
              "So viele Stuecke stehen wirklich in der .blend. Im fertigen "
              "Bild sind es genau so",
              "viele -- kein Stuhl mehr, kein Schrank weniger.", ""]
    erledigt = set()
    for stamm in sorted(vorhandene):
        if stamm in erledigt:
            continue
        kind = next((k for k, e in paare.items() if e == stamm), None)
        if kind:
            anzahl = len(stuecke[kind])
            titel = PAAR_NAME.get(kind, "%s mit %%d" % stamm) % anzahl
            zeilen.append(
                "- **%s** — `%s` (%d) und `%s` (%d) gehoeren zusammen: "
                "%s beim Bauen aus dem Elternobjekt abgeleitet und steh%s "
                "schon daran. Es kommt nichts dazu. "
                "Im Bild sind es genau %d."
                % (titel, stamm, len(stuecke[stamm]), kind, anzahl,
                   ("die %d Stuehle wurden" % anzahl) if anzahl != 1
                   else "der eine Stuhl wurde",
                   "en" if anzahl != 1 else "t", anzahl))
            erledigt.add(stamm)
            erledigt.add(kind)
            continue
        zeilen.append("- `%s`: %d" % (stamm, len(stuecke[stamm])))
        erledigt.add(stamm)

    zeilen += ["",
               "**Vor dem Abgeben nachzaehlen.** In jedem gelieferten Bild "
               "jede Sorte durchzaehlen",
               "und mit dieser Liste vergleichen. Eine Zahl, die nicht "
               "stimmt, ist eine abgelehnte",
               "Lieferung -- am 2026-08-31 standen neun Stuehle an einem "
               "Tisch fuer sechs.", ""]
    return zeilen




NACHWEIS_MARKE = "NACHWEIS:"


def nachweis_abschnitt(nachweis):
    """Die Frage, die nur beantworten kann, wer die Datei geoeffnet hat.

    Rainer, 2026-08-31: "hes guessing again". Der Auftrag verlangt seit dem
    2026-08-30 unter "OEFFNEN heisst AUFMACHEN", die .blend wirklich
    aufzumachen. Codex hatte am selben Tag zugegeben, es noch nie getan zu
    haben, und die Lieferung danach zeigte dieselben Fehler.

    Prosa laesst sich ueberlesen, eine Zahl nicht. Gefragt wird nach der
    Anzahl der MESH-Objekte -- die Objektliste im Auftrag nennt nur Moebel,
    Waende, Boeden, Fenster und Dach fehlen darin. Die Summe ist also nicht
    ausrechenbar, nur auslesbar.

    Die erwartete Antwort steht in codex-job.json, nicht hier: eine Zahl im
    Auftragstext wird abgeschrieben statt nachgesehen -- so wie am
    2026-08-29 die Marker-Koordinaten.
    """
    if not nachweis or not nachweis.get("mesh_objekte"):
        return []
    return ["", "## Nachweis, dass die .blend offen war", "",
            "Der Befehl oben gibt eine Zeile je MESH-Objekt aus. Zaehle sie "
            "und trage die Zahl",
            "in `catalog.json` ein, als eigenes Feld neben den Bildern:", "",
            '    "nachweis": "%s <zahl> MESH-Objekte"' % NACHWEIS_MARKE, "",
            "Die Zahl steht in keiner Datei, die du sonst bekommst -- die "
            "Objektliste in diesem",
            "Auftrag nennt nur Moebel, nicht Waende, Boeden, Fenster und "
            "Dach. Wer sie richtig",
            "nennt, hat die Datei offen gehabt.", "",
            "**Ohne diese Zeile wird die Lieferung nicht geprueft.** Eine "
            "falsche Zahl ebenfalls",
            "nicht: dann ist woanders nachgesehen worden.", ""]


def nachweis_stimmt(rueckgabe, nachweis):
    """Hat die Rueckgabe die richtige Objektzahl?

    True, False -- oder None, wenn der Auftrag gar keinen Nachweis verlangt
    hat. Alte Auftraege duerfen daran weder scheitern noch stillschweigend
    bestehen; der Aufrufer soll den Unterschied sehen.
    """
    if not nachweis or not nachweis.get("mesh_objekte"):
        return None
    erwartet = int(nachweis["mesh_objekte"])
    for zeile in (rueckgabe or "").splitlines():
        if NACHWEIS_MARKE not in zeile:
            continue
        zahlen = re.findall(r"\d+", zeile.split(NACHWEIS_MARKE, 1)[1])
        if zahlen and int(zahlen[0]) == erwartet:
            return True
    return False



