    ("soft-scandinavian", "Soft Scandinavian"),
    ("classic",           "Classic"),
)


def _geschoss_kuerzel(stem):
    """eg/og aus dem Namen der Innen-.blend, oder None bei nur einem Geschoss."""
    rest = stem.replace("interior-", "").replace("-baseline", "")
    for kuerzel in ("upper", "og", "obergeschoss"):
        if kuerzel in rest:
            return "og"
    for kuerzel in ("lower", "eg", "erdgeschoss", "ground"):
        if kuerzel in rest:
            return "eg"
    return None


