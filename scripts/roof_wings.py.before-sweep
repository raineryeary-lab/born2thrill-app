"""Two-wing gable roof on an L-shaped footprint (born2thrill-local-workbench/
plans/zweischenkliges-satteldach-v1.md).

Rainer, 2026-09-22, an `german_catalog_review_bungalow_4_3_1_wb_125` (eine
echte L-Form, eine ueberdachte Terrasse als Einschnitt): "the doppelpultdach
is a walmdach in blender" -- bestaetigt: render-exterior.py faellt fuer jede
nicht-rechteckige Form auf ein Walmdach zurueck (siehe dort, ~1163-1166).
Dann: "but this for example is exactly one of our standard houses" -- eigene
Messung (2026-09-22) bestaetigte das: von 124 auswertbaren Haeusern zerlegen
sich 39 (31 %) in genau zwei Rechtecke.

Dieses Modul deckt STUFE 1 des Plans: die WANDGEOMETRIE erkennen (welche zwei
sich ueberlappenden Rechtecke ergeben zusammen genau diesen Grundriss). Reine
Funktionen, kein bpy -- testbar ohne Blender, nach dem Vorbild von
roof_profile.py. Die eigentliche Dachflaeche (Grat/Kehle-Vernetzung,
Wandanschluss) ist Stufe 2 und noch NICHT hier -- siehe die "Unresolved
questions" im Plan: die Kehlengeometrie zwischen zwei ungleich breiten
Fluegeln hat mehrere Faelle (welcher First zuerst erreicht wird), und die
falsch zu bauen waere schlimmer als weiterhin ein Walmdach zu zeigen.

Nur EIN Reflexpunkt wird unterstuetzt (ein einfaches L) -- T-Formen (zwei
Reflexpunkte) sind ausdruecklich ausserhalb von Version 1 (Plan, "Explicitly
out of scope"). Ein Grundriss, der sich nicht eindeutig in zwei sich
ueberlappende Rechtecke zerlegen laesst, liefert None -- der Aufrufer faellt
dann auf das bestehende Walmdach zurueck, wie heute.
"""
import math

# Wieviel eine Ecke von der wirklichen Grundflaeche abweichen darf (Meter) --
# dieselbe Groessenordnung wie render-exterior.py regularize_loop()s
# Standard-Toleranz (0.35 m), aus demselben Grund: eine getracte Wandschleife
# ist nie pixelgenau.
DEFAULT_TOL_M = 0.35


def point_in_polygon(x, y, poly):
    """Reiner Nachbau von render-exterior.py point_in_polygon() -- absichtlich
    eine eigene, unabhaengige Kopie: dieses Modul bleibt bpy-frei und darf
    render-exterior.py (importiert bpy) nicht importieren."""
    inside = False
    n = len(poly)
    j = n - 1
    for i in range(n):
        xi, yi = poly[i]
        xj, yj = poly[j]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            inside = not inside
        j = i
    return inside


def polygon_area(poly):
    total = 0.0
    for i in range(len(poly)):
        x1, y1 = poly[i]
        x2, y2 = poly[(i + 1) % len(poly)]
        total += x1 * y2 - x2 * y1
    return abs(total) / 2


def _signed_area(poly):
    total = 0.0
    for i in range(len(poly)):
        x1, y1 = poly[i]
        x2, y2 = poly[(i + 1) % len(poly)]
        total += x1 * y2 - x2 * y1
    return total / 2


def _reflex_vertices(poly):
    """Indizes der einspringenden (reflex) Ecken eines EINFACHEN, CCW
    orientierten, rechtwinkligen Polygons. Ein rechteckiger Grundriss hat
    keine; ein einfaches L genau eine; ein T oder Z zwei."""
    n = len(poly)
    out = []
    for i in range(n):
        a, b, c = poly[(i - 1) % n], poly[i], poly[(i + 1) % n]
        cross = (b[0] - a[0]) * (c[1] - b[1]) - (b[1] - a[1]) * (c[0] - b[0])
        if cross < -1e-9:
            out.append(i)
    return out


def _grid_coverage_matches(poly, wing_a, wing_b, tol):
    """Stimmt die Vereinigung der zwei Rechtecke mit dem Grundriss ueberein?
    Rastersuche wie render-exterior.py decompose_rectangles() (dort schon
    akzeptiert und getestet) statt analytischer Polygon-Differenz -- diese
    Codebase hat keine Polygon-Bibliothek (kein shapely, siehe
    aussenflaechen-ausrichten.js-Arbeit desselben Tages).

    Samples ZELLMITTEN, nie Rasterlinien: point_in_polygon() (Ray-Casting)
    ist auf einer Kante nicht eindeutig definiert, und Rasterlinien treffen
    hier fast immer eine Kante (die Bounding-Box-Raender SIND ja Kanten des
    Polygons). decompose_rectangles() vermeidet das aus demselben Grund
    schon so."""
    xs = [p[0] for p in poly]
    ys = [p[1] for p in poly]
    x0, x1, y0, y1 = min(xs), max(xs), min(ys), max(ys)
    step = max(tol / 3, 0.02)
    nx = max(4, int((x1 - x0) / step))
    ny = max(4, int((y1 - y0) / step))

    def in_wing(x, y, wing):
        wx0, wx1, wy0, wy1 = wing
        return wx0 - 1e-6 <= x <= wx1 + 1e-6 and wy0 - 1e-6 <= y <= wy1 + 1e-6

    for i in range(nx):
        for j in range(ny):
            x = x0 + (x1 - x0) * (i + 0.5) / nx
            y = y0 + (y1 - y0) * (j + 0.5) / ny
            innen = point_in_polygon(x, y, poly)
            gedeckt = in_wing(x, y, wing_a) or in_wing(x, y, wing_b)
            if innen != gedeckt:
                return False
    return True


def recognize_two_wings(poly, tol=DEFAULT_TOL_M):
    """Versucht, `poly` (geschlossen, CCW, rechtwinklig, Meter) als
    Vereinigung von zwei sich ueberlappenden achsparallelen Rechtecken zu
    lesen, die an GENAU einem Reflexpunkt zusammenstossen (ein einfaches L).

    `wing_a` spannt immer die VOLLE x-Ausdehnung der Bounding-Box (sein First
    laeuft also entlang x); `wing_b` die volle y-Ausdehnung (First entlang y)
    -- dieselbe along_x-Konvention wie roof_profile.py _axes().

    Rueckgabe: (wing_a, wing_b), je (x0,x1,y0,y1), oder None, wenn sich der
    Grundriss nicht eindeutig so zerlegen laesst (kein L, ein T/Z, oder die
    Vereinigung deckt den Grundriss nicht exakt).
    """
    if len(poly) < 3:
        return None
    if _signed_area(poly) < 0:
        poly = list(reversed(poly))
    reflex = _reflex_vertices(poly)
    if len(reflex) != 1:
        return None

    xs = [p[0] for p in poly]
    ys = [p[1] for p in poly]
    x0, x1, y0, y1 = min(xs), max(xs), min(ys), max(ys)
    rx, ry = poly[reflex[0]]
    if not (x0 + tol < rx < x1 - tol and y0 + tol < ry < y1 - tol):
        return None   # Reflexpunkt zu nah am Rand: entartet, kein sauberes L

    inset = tol / 2
    corners = {
        (x0, y0): (x0 + inset, y0 + inset),
        (x1, y0): (x1 - inset, y0 + inset),
        (x0, y1): (x0 + inset, y1 - inset),
        (x1, y1): (x1 - inset, y1 - inset),
    }
    missing = [corner for corner, probe in corners.items()
              if not point_in_polygon(probe[0], probe[1], poly)]
    if len(missing) != 1:
        return None
    mx, my = missing[0]

    wing_a = (x0, x1, ry, y1) if my == y0 else (x0, x1, y0, ry)
    wing_b = (x0, rx, y0, y1) if mx == x1 else (rx, x1, y0, y1)

    if not _grid_coverage_matches(poly, wing_a, wing_b, tol):
        return None
    return wing_a, wing_b


def _vertical_scan_bracket(poly, x, y):
    """The two nearest HORIZONTAL-edge y-crossings of `poly` at column `x`
    that bracket `y` from below and above -- the footprint's own
    cross-extent at this (x,y), used by `roof_wings_from_ridge_path()` to
    find a horizontal ridge segment's wing width. `None` if `x` isn't
    spanned by a bracketing pair (shouldn't happen for a point genuinely
    inside a simple rectilinear polygon)."""
    crossings = []
    n = len(poly)
    for i in range(n):
        x1, y1 = poly[i]
        x2, y2 = poly[(i + 1) % n]
        if abs(y1 - y2) > 1e-9:
            continue          # not a horizontal edge
        lo, hi = (x1, x2) if x1 <= x2 else (x2, x1)
        if lo - 1e-6 <= x <= hi + 1e-6:
            crossings.append(y1)
    below = [c for c in crossings if c <= y + 1e-6]
    above = [c for c in crossings if c >= y - 1e-6]
    if not below or not above:
        return None
    return max(below), min(above)


def _horizontal_scan_bracket(poly, y, x):
    """Mirror of `_vertical_scan_bracket()` for a VERTICAL ridge segment
    (fixed x, scanning at height y against VERTICAL edges)."""
    crossings = []
    n = len(poly)
    for i in range(n):
        x1, y1 = poly[i]
        x2, y2 = poly[(i + 1) % n]
        if abs(x1 - x2) > 1e-9:
            continue          # not a vertical edge
        lo, hi = (y1, y2) if y1 <= y2 else (y2, y1)
        if lo - 1e-6 <= y <= hi + 1e-6:
            crossings.append(x1)
    left = [c for c in crossings if c <= x + 1e-6]
    right = [c for c in crossings if c >= x - 1e-6]
    if not left or not right:
        return None
    return max(left), min(right)


def _extend_ridge_end(end_pt, inward_pt, footprint):
    """Pushes ONE free end of a drawn ridge path out to the footprint's
    own true edge (overhang included, since `footprint` here is already
    the overhang-extended polygon), along the axis `end_pt` -> `inward_pt`
    already runs.

    Rainer, 2026-09-27, ROOF-RIDGE-PATH-TOOL-001 second pass: "so it also
    takes on the width of the Floorplan footprint plus tha dachueberstand
    inclidun at the start and finish" -- a hand-drawn point on a 160x160px
    mini-canvas is never going to land pixel-perfect on the true wall
    corner (confirmed live: WB_125's own test path stopped ~0.9m short of
    the real gable, leaving a visible gap between the roof sheet's edge
    and the wall/overhang beneath it). Reuses the SAME scan-bracket
    helpers `roof_wings_from_ridge_path()` already trusts for the CROSS
    axis, just swapped to the ALONG axis: `_horizontal_scan_bracket()` for
    a horizontal segment's own x-extent, `_vertical_scan_bracket()` for a
    vertical segment's own y-extent. `None` (scan failed) leaves the point
    untouched rather than guessing.

    Only ever called on `path[0]`/`path[-1]` -- an INTERIOR corner (shared
    by two segments, an L/T/plus junction) must stay exactly as drawn, or
    extending it would push one wing's ridge past where the other wing's
    own roof actually ends."""
    x1, y1 = end_pt
    x2, y2 = inward_pt
    horiz = abs(y1 - y2) <= 1e-6 and abs(x1 - x2) > 1e-6
    vert = abs(x1 - x2) <= 1e-6 and abs(y1 - y2) > 1e-6
    if horiz:
        bracket = _horizontal_scan_bracket(footprint, y1, x1)
        if bracket is None:
            return end_pt
        lo, hi = bracket
        return (lo, y1) if x1 <= x2 else (hi, y1)
    if vert:
        bracket = _vertical_scan_bracket(footprint, x1, y1)
        if bracket is None:
            return end_pt
        lo, hi = bracket
        return (x1, lo) if y1 <= y2 else (x1, hi)
    return end_pt              # diagonal/degenerate -- caller's own segment check rejects this


def _same_axis_wings_disagree(wings, along_x_list, tol=DEFAULT_TOL_M):
    """Find two wings that share a ridge axis (both along_x or both
    along_y), overlap along that axis, but disagree on their CROSS extent
    -- i.e. their height functions genuinely conflict over shared ground
    instead of one being a harmless redundant subset of the other.
    Returns the offending `(i, j)` index pair, or `None` if every
    same-axis overlap agrees.

    `ROOF-SWEEP-CONSTRUCTOR-001`, 2026-09-29: `german_catalog_review_
    bungalow_4_3_1_wb_125`'s real, previously-saved ridge path (Rainer's
    own Blender viewport: "that doesnt look like a working roof") produced
    exactly this: a segment drawn partway across the main wing, inside the
    side wing's own x-range, had its perpendicular scan pick up the side
    wing's much taller reach -- a wing with a wildly different cross-extent
    than the very next segment's own, correctly-scanned main-wing wing,
    despite both running along the same axis and overlapping in x. Taking
    max() of two conflicting symmetric ridge functions over that shared
    area is what produced the crossed/jagged surface.

    A same-axis overlap that does NOT reach this far is legitimate and
    already relied on by an existing test: a redundant sub-rectangle wing
    (IDENTICAL cross-extent -- e.g. a T-shape's backtracked bar segment,
    `roof_wings.test.py`'s `test_a_t_shaped_path_...`) contributes no new
    area and is harmless. A DIFFERENT-axis overlap (an ordinary L/T corner
    elbow, where one wing's ridge runs along x and the other along y) is
    the normal, expected junction shape and is never flagged here."""
    for i in range(len(wings)):
        for j in range(i + 1, len(wings)):
            if along_x_list[i] != along_x_list[j]:
                continue                          # perpendicular ridges: a normal corner
            a, b = wings[i], wings[j]
            if along_x_list[i]:
                lo_i, hi_i, cross_i = a[0], a[1], (a[2], a[3])
                lo_j, hi_j, cross_j = b[0], b[1], (b[2], b[3])
            else:
                lo_i, hi_i, cross_i = a[2], a[3], (a[0], a[1])
                lo_j, hi_j, cross_j = b[2], b[3], (b[0], b[1])
            if min(hi_i, hi_j) - max(lo_i, lo_j) <= tol:
                continue                          # touch at a point at most, not a real overlap
            if abs(cross_i[0] - cross_j[0]) > tol or abs(cross_i[1] - cross_j[1]) > tol:
                return (i, j)
    return None


def roof_wings_from_ridge_path(path, footprint, tol=DEFAULT_TOL_M):
    """`ROOF-RIDGE-PATH-TOOL-001`, 2026-09-27. Rainer: "make it like the
    kitchen counter, so that i can draw a line in the floorplan and you
    extrude a triangulare shape ... along this path" -- instead of
    AUTO-DETECTING wing rectangles from the footprint alone
    (`recognize_two_wings()`, L-shapes only, one reflex point), derive
    them from a ridge line the user drew directly, with corners allowed
    (an L, T, plus, or any other rectilinear shape -- not limited to one
    reflex point the way automatic detection is).

    `path`: >=2 points (metres), ONE continuous polyline -- each
    consecutive pair is a ridge segment. Every segment must be axis-
    aligned (same y = horizontal segment, ridge along x; same x =
    vertical segment, ridge along y) -- a free-angle segment is
    explicitly out of scope (see the plan doc) and makes this function
    return `None` rather than silently building the wrong roof.

    `footprint`: the real building outline (metres, CCW, rectilinear --
    same convention as `recognize_two_wings()`'s own `poly`).

    The path's own two FREE ENDS (`path[0]` and `path[-1]`) are pushed out
    to the footprint's true edge first (`_extend_ridge_end()` -- overhang
    included), so the drawn ridge always reaches the real gable regardless
    of exactly where the user clicked. Every OTHER (interior) point is an
    L/T/plus junction between two wings and is never moved.

    For each segment: the ridge axis and the wing's extent ALONG that
    axis come directly from the segment's own two endpoints (after the
    free-end extension above, for the path's first/last segment) -- so an
    interior corner intentionally drawn short of a T-junction's own far
    wall is still a valid partial gable, not an error. The wing's extent
    ACROSS the ridge axis comes from scanning the footprint perpendicular
    to the segment at each of its endpoints AND its midpoint, then taking
    the NARROWEST result across those three samples (the same "safe =
    never poke through" precedent already established this session for
    `_long_wall_ramp()`) -- exact for a segment whose footprint width is
    genuinely constant along its length (verified against `recognize_two_
    wings()`'s own known-good numbers on `SIMPLE_L`), a safe under-estimate
    otherwise.

    Returns `(wings, along_x)` -- the exact shapes `heightfield_roof_
    mesh()`/`combined_height_at()`/`wall_extension()` already consume,
    unchanged by this function -- or `None` if the path is too short, has
    a non-orthogonal or degenerate segment, or a segment's footprint scan
    fails (e.g. an endpoint sits exactly on the footprint's own boundary,
    not safely inside it)."""
    if len(path) < 2:
        return None
    path = list(path)
    path[0] = _extend_ridge_end(path[0], path[1], footprint)
    path[-1] = _extend_ridge_end(path[-1], path[-2], footprint)
    wings = []
    along_x_list = []
    for (x1, y1), (x2, y2) in zip(path, path[1:]):
        horiz = abs(y1 - y2) <= 1e-6
        vert = abs(x1 - x2) <= 1e-6
        if horiz == vert:      # both or neither -- diagonal, or zero-length
            return None
        if horiz:
            x_lo, x_hi = (x1, x2) if x1 <= x2 else (x2, x1)
            if x_hi - x_lo < tol:
                return None
            y_mid = (y1 + y2) / 2.0
            brackets = [_vertical_scan_bracket(footprint, sx, y_mid)
                       for sx in (x_lo, x_hi, (x_lo + x_hi) / 2.0)]
            if any(b is None for b in brackets):
                return None
            cross_lo = max(b[0] for b in brackets)
            cross_hi = min(b[1] for b in brackets)
            if cross_hi - cross_lo < tol:
                return None
            wings.append((x_lo, x_hi, cross_lo, cross_hi))
            along_x_list.append(True)
        else:
            y_lo, y_hi = (y1, y2) if y1 <= y2 else (y2, y1)
            if y_hi - y_lo < tol:
                return None
            x_mid = (x1 + x2) / 2.0
            brackets = [_horizontal_scan_bracket(footprint, sy, x_mid)
                       for sy in (y_lo, y_hi, (y_lo + y_hi) / 2.0)]
            if any(b is None for b in brackets):
                return None
            cross_lo = max(b[0] for b in brackets)
            cross_hi = min(b[1] for b in brackets)
            if cross_hi - cross_lo < tol:
                return None
            wings.append((cross_lo, cross_hi, y_lo, y_hi))
            along_x_list.append(False)
    conflict = _same_axis_wings_disagree(wings, along_x_list, tol)
    if conflict is not None:
        i, j = conflict
        print(f"[roof_wings] ridge path rejected: segments {i} and {j} "
              f"share a ridge axis and overlap, but their footprint-scanned "
              f"cross-extents disagree ({wings[i]} vs {wings[j]}) -- the "
              f"path likely backtracks through ground a later segment "
              f"re-covers differently. Falling back to automatic wing "
              f"detection instead of building this path.")
        return None
    return wings, along_x_list


def wing_ridge_along_x(wing):
    """Laeuft dieser Fluegels First entlang x (volle x-Ausdehnung, First
    quer zur y-Achse) oder entlang y? Mirrors roof_profile.py _axes()."""
    x0, x1, y0, y1 = wing
    return (x1 - x0) >= (y1 - y0)


def wing_height_m(wing, pitch_tan, x, y):
    """Dachhoehe UEBER der Traufe an (x,y) fuer diesen EINEN Fluegel -- ein
    mittiger, symmetrischer Giebel (wie roof_profile.py Satteldach mit
    u=0.5), 0 ausserhalb des Fluegel-Rechtecks (damit max() ueber mehrere
    Fluegel diesen Fluegel dort korrekt ignoriert)."""
    x0, x1, y0, y1 = wing
    if not (x0 - 1e-6 <= x <= x1 + 1e-6 and y0 - 1e-6 <= y <= y1 + 1e-6):
        return 0.0
    if wing_ridge_along_x(wing):
        return max(0.0, min(y - y0, y1 - y)) * pitch_tan
    return max(0.0, min(x - x0, x1 - x)) * pitch_tan


def combined_height_m(wings, pitch_tan, x, y):
    """Dachhoehe an (x,y) ueber ALLEN Fluegeln -- das obere Blatt der sich
    ueberlagernden Dachflaechen (Codex-Design-Review, 2026-09-22: "z =
    max(z1, z2)")."""
    return max((wing_height_m(w, pitch_tan, x, y) for w in wings), default=0.0)


def reflex_point(wing_a, wing_b):
    """Die einspringende Ecke, an der zwei von recognize_two_wings()
    erkannte Fluegel zusammenstossen -- aus den beiden Rechtecken
    zurueckgerechnet (robust gegen alle 4 Ecken-Orientierungen aus
    recognize_two_wings(), ohne das urspruengliche Polygon erneut zu
    brauchen).

    Rainer, 2026-09-22, Doppelpultdach auf einem L: "i dont want a
    walmdach instead of the doppelpultdach" -- gebraucht fuer
    `roof_profile.py`s Hoehenfeld, um den First-des-durchgehenden-
    Fluegels (siehe `HEIGHT_VALLEY_MARGIN_M` dort) nicht ueber die volle
    Rechteck-Ausdehnung wirken zu lassen, sondern nur nahe der echten
    Kehle."""
    x0 = min(wing_a[0], wing_b[0])
    x1 = max(wing_a[1], wing_b[1])
    y0 = min(wing_a[2], wing_b[2])
    y1 = max(wing_a[3], wing_b[3])
    rx = ry = None
    for w in (wing_a, wing_b):
        wx0, wx1, wy0, wy1 = w
        full_x = abs(wx0 - x0) < 1e-6 and abs(wx1 - x1) < 1e-6
        full_y = abs(wy0 - y0) < 1e-6 and abs(wy1 - y1) < 1e-6
        if full_x and not full_y:
            ry = wy0 if abs(wy0 - y0) > 1e-6 else wy1
        if full_y and not full_x:
            rx = wx0 if abs(wx0 - x0) > 1e-6 else wx1
    return rx, ry


def clip_wing_to_valley(wing, other_wing, rx, ry, margin):
    """Wenn `wing` die volle Ausdehnung EINER Achse hat (der "durchgehende"
    Fluegel, x0..x1 oder y0..y1), waehrend `other_wing` an der Kehle
    (rx,ry) endet, reicht `wing`s eigenes Rechteck per Konstruktion tief in
    `other_wing`s wahres Gebiet hinein (das ist fuer die REINE Flaechen-
    Abdeckung richtig und noetig -- `other_wing` deckt seinen Teil schon
    selbst ab). Fuer die HOEHE ist das falsch: `wing`s First laeuft dort
    konstant weiter und "sticht" durch `other_wing`s viel niedrigere
    eigene Traufe (Rainer, 2026-09-22, Doppelpultdach: "3 roofs in one ...
    90 degrees from each other" -- der Grat des durchgehenden Fluegels lag
    weit in fremdem Gebiet).

    Deckelt `wing`s Rechteck auf dieser Achse auf `margin` Abstand von der
    Kehle -- nur auf der Seite, die in `other_wing`s eigenes Gebiet reicht.
    Reine Geometrie, keine Ahnung von Dachform/Profil; wird nur fuer die
    HOEHENBERECHNUNG benutzt, nie fuer die Flaechen-Abdeckung (`covered()`
    in `roof_profile.heightfield_roof_mesh()` bekommt weiterhin das
    UNGEKUERZTE `wing`)."""
    wx0, wx1, wy0, wy1 = wing
    ox0, ox1, oy0, oy1 = other_wing

    def spans_full(lo, hi, olo, ohi):
        full = min(lo, olo) == lo and max(hi, ohi) == hi
        other_full = abs(olo - lo) < 1e-6 and abs(ohi - hi) < 1e-6
        return full and not other_full

    if spans_full(wy0, wy1, oy0, oy1):
        if abs(oy1 - ry) < 1e-6:
            wy0 = max(wy0, ry - margin)
        elif abs(oy0 - ry) < 1e-6:
            wy1 = min(wy1, ry + margin)
    if spans_full(wx0, wx1, ox0, ox1):
        if abs(ox1 - rx) < 1e-6:
            wx0 = max(wx0, rx - margin)
        elif abs(ox0 - rx) < 1e-6:
            wx1 = min(wx1, rx + margin)
    return (wx0, wx1, wy0, wy1)
