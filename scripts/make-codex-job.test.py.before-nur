                            "interiors": ".", "naming": "."},
            "publish": {"command": ".", "note": "."},
        }
        self.assertIn("Zwerchkubus", self.mod.render_markdown(job))


class StuffRaumNahtTests(unittest.TestCase):
    """stuff-raum-an-codex-v1 (Rainer, 2026-10-23): "plan the fix so every
    Stuff box tells Codex which room it is in". `_marker_liste` konnte den
    Raum schon, aber der echte Aufruf gab ihn nie mit."""

    def setUp(self):
        self.mod = load_module()

    def _lauf(self, stdout):
        from unittest import mock
        ergebnis = mock.Mock(stdout=stdout)
        with mock.patch.object(self.mod.os.path, "exists", return_value=True), \
                mock.patch.object(self.mod.subprocess, "run", return_value=ergebnis):
            return self.mod.objekte_und_lagen("egal.blend")

    def test_der_blender_lauf_liest_den_raum_mit(self):
        _, _, _, _, masse = self._lauf("\n".join([
            "OBJEKTE-ANFANG",
            "OBJ stuff-3-shelf-back",
            "LAGE stuff-3-shelf-back 0.4 0.5",
            "RAUM stuff-3-shelf-back HWR / HTR",
            "OBJEKTE-ENDE"]))
        self.assertEqual(masse["stuff-3-shelf-back"]["raum"], "HWR / HTR")

    def test_raeume_je_bauteil(self):
        raeume = self.mod.raeume_aus_massen({
            "stuff-3-shelf-back": {"raum": "Fitness"},
            "stuff-3-shelf-board-0": {"raum": "Fitness"},
            "doppelbett-1": {"masse_mm": [1, 2, 3]}})
        self.assertEqual(raeume, {"stuff-3": "Fitness"})

    def test_die_naht_fitness_kommt_im_marker_an(self):
        masse = {"stuff-3-shelf-back": {"raum": "Fitness"}}
        marker = self.mod._marker_liste(
            {"stuff": ["stuff-3-shelf-back"]}, {"stuff-3-shelf-back": [0.5, 0.5]},
            masse, raeume=self.mod.raeume_aus_massen(masse))
        self.assertIn("Laufband", marker[0]["rolle"])

    def test_alte_datei_ohne_raum_bleibt_allgemein(self):
        self.assertEqual(self.mod.raeume_aus_massen({"stuff-3-shelf-back": {}}), {})

    def test_der_echte_aufruf_gibt_die_raeume_mit(self):
        quelle = (HERE / "make-codex-job.py").read_text(encoding="utf-8")
        self.assertIn("raeume=raeume_aus_massen(eigene_masse)", quelle)
        self.assertIn("'RAUM'", quelle)

if __name__ == "__main__":
    unittest.main()
