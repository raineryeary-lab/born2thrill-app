class EinOrdnerEinKnopfTests(unittest.TestCase):
    """Plan codex-ein-ordner-ein-knopf-v1 (Rainer, 2026-10-20): "the paths
    and all the BS should be created when we press the button an Codex"."""

    def setUp(self):
        self.mod = load_module()

    def test_anzahl_satz_anderthalb(self):
        req = self.mod.outputs_for(["exterior-satteldach-baseline.blend",
                                    "interior-modern-baseline.blend",
                                    "interior-modern-upper-baseline.blend"])
        satz = self.mod.anzahl_satz(req)
        self.assertIn("1 Aussenansicht ", satz)
        self.assertIn("9 Bilder", satz)

    def test_anzahl_satz_zweigeschosser_vier_daecher(self):
        req = self.mod.outputs_for(["exterior-%s-baseline.blend" % d for d in
                                    ("flachdach", "walmdach", "satteldach", "pultdach")]
                                   + ["interior-modern-baseline.blend",
                                      "interior-modern-upper-baseline.blend"])
        satz = self.mod.anzahl_satz(req)
        self.assertIn("4 Aussenansichten", satz)
        self.assertIn("12 Bilder", satz)

    def test_alter_satz_ist_weg(self):
        self.assertNotIn("zwei Aussenansichten", self.mod.INNEN_REGEL)
        self.assertNotIn("4 je Geschoss + 2", self.mod.INNEN_REGEL)

    def test_lieferordner_steht_ganz_oben(self):
        job = {
            "job_id": "haus-2026-10-20", "plan_id": "haus",
            "folder": r"E:\daten\haus\renders\go-baseline",
            "delivery_folder": r"E:\daten\haus\renders\codex-haus-2026-10-20",
            "source": {}, "inputs": [], "required_outputs": [],
            "constraints": {"models_locked": ".", "exterior_hero_shot": ".",
                            "interiors": ".", "naming": "."},
            "publish": {"command": ".", "note": "."},
        }
        oben = "\n".join(self.mod.render_markdown(job).splitlines()[:15])
        self.assertIn(job["delivery_folder"], oben)

    def test_lieferordner_wird_angelegt(self):
        with tempfile.TemporaryDirectory() as tmp:
            ziel = os.path.join(tmp, "renders", "codex-haus-2026-10-20")
            self.mod.lieferordner_anlegen({"delivery_folder": ziel})
            self.assertTrue(os.path.isdir(ziel))
            self.mod.lieferordner_anlegen({"delivery_folder": ziel})   # zweimal: kein Fehler

    def test_main_legt_den_ordner_an(self):
        # Die Naht, nicht nur die Funktion: main() muss sie aufrufen.
        import inspect
        self.assertIn("lieferordner_anlegen(job)", inspect.getsource(self.mod.main))


class ZwerchkubusVarianteTests(unittest.TestCase):
    """Plan anderthalb-zwerchkubus-modern-v1: Codex muss wissen, welche Aussenansicht welche ist."""

    def setUp(self):
        self.mod = load_module()

    def test_anderthalb_zwei_aussen_mit_variante(self):
        req = self.mod.outputs_for(["exterior-satteldach-baseline.blend",
                                    "exterior-satteldach-kubus-baseline.blend",
                                    "interior-modern-baseline.blend"])
        aussen = {r["from_blend"]: r for r in req if r["kind"] == "exterior"}
        self.assertIn("Zwerchkubus", aussen["exterior-satteldach-kubus-baseline.blend"]["variante"])
        self.assertIn("Zwerchgiebel", aussen["exterior-satteldach-baseline.blend"]["variante"])
        self.assertIn("2 Aussenansichten", self.mod.anzahl_satz(req))

    def test_vier_daecher_ohne_variante(self):
