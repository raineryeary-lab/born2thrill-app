"""Der Auftrag muss sagen, WO ein Objekt liegt -- nicht nur, wie es heisst.

Rainer, 2026-08-27, nach der Lieferung fuer
german_catalog_review_bungalow_3_2_3_b_100_1: die Garderobe
(`garderobe-25`, Bauplan x=4550 y=3246) stand in vier Bildern an drei
verschiedenen Stellen. Zweimal ersetzte sie das offene Tuerblatt der
Haustuer, zweimal wurde stattdessen eine Garderobenleiste an einer
Dielenwand erfunden, an der die .blend nichts hat.

Die Ursache war nicht Nachlaessigkeit, sondern fehlende Information: der
Auftrag nannte den Objektnamen, und ein aufgeschlagenes Tuerblatt sieht im
Rohrender aus wie ein Schrankbrett. Diese Tests decken die Rechenwege der
Objektkarte ab -- Blender und Pillow bleiben aussen vor, damit sie ohne
beides laufen.
"""

import importlib.util
import os
import tempfile
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent

# Das Modul verweigert den Start ohne gesetzten Datenordner. Das ist
# beabsichtigt (ein stiller Rueckfall auf den alten C:-Pfad wuerde gegen
# veraltete Daten arbeiten), also setzen die Tests ihn vor dem Laden.
os.environ.setdefault("FLOORPLAN_WORKBENCH_DATA_DIR", str(HERE))


def load_module():
    spec = importlib.util.spec_from_file_location(
        "make_codex_job", HERE / "make-codex-job.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class FrontImBildTests(unittest.TestCase):
    """Rainer, 2026-10-13: die Front der Hochschraenke zeigte von der Kamera
    weg, und Codex setzte den Ofen auf die sichtbare Seite. Die Pfeilrichtung
    der Karte steht deshalb auch als Wort im Auftrag."""

    def setUp(self):
        self.mod = load_module()

    def test_bildrichtungen(self):
        f = self.mod.front_im_bild
        self.assertEqual(f([100, 100], [140, 100]), "rechts")
        self.assertEqual(f([100, 100], [130, 70]), "rechts oben")   # Bild-y waechst nach unten
        self.assertEqual(f([100, 100], [100, 60]), "oben")
        self.assertEqual(f([100, 100], [70, 130]), "links unten")
        self.assertIsNone(f(None, [1, 2]))
        self.assertIsNone(f([1, 1], [1, 1]))


class LageZuPixelTests(unittest.TestCase):
    def setUp(self):
        self.mod = load_module()

    def test_flips_the_vertical_axis(self):
        """Blender misst von unten, ein Bild von oben.

        Ohne die Spiegelung sitzt jeder Marker am gespiegelten Ort -- und
        eine Karte, die auf den falschen Raum zeigt, ist schlimmer als gar
        keine.
        """
        self.assertEqual(self.mod._lage_zu_pixel(0.5, 0.0, 2000, 1500),
                         (1000, 1500))
        self.assertEqual(self.mod._lage_zu_pixel(0.5, 1.0, 2000, 1500),
                         (1000, 0))

    def test_maps_the_horizontal_axis_straight_through(self):
        self.assertEqual(self.mod._lage_zu_pixel(0.0, 0.5, 2000, 1500)[0], 0)
        self.assertEqual(self.mod._lage_zu_pixel(1.0, 0.5, 2000, 1500)[0], 2000)

    def test_keeps_points_outside_the_frame_outside(self):
        """Nicht heimlich an den Rand klemmen.

        Ein Objekt ausserhalb des Bildes ist eine Aussage ueber die Szene.
        Wer es auf den Rand zieht, behauptet eine Lage, die es nicht gibt.
        """
        x, y = self.mod._lage_zu_pixel(1.4, -0.2, 1000, 1000)
        self.assertGreater(x, 1000)
        self.assertGreater(y, 1000)


class TuerblattTests(unittest.TestCase):
    """Tuerblaetter gehoeren auf die Karte -- sie sind das, was verwechselt wird.

    `wall-12-door` misst aufgeschlagen 898 x 898 mm und projiziert 190 Pixel
    neben `garderobe-25`. Zwei Nachbesserungsrunden am 2026-08-27 haben in
    Soft Scandinavian und Classic dasselbe geliefert: Garderobe richtig,
    Tuerblatt weg. Ohne Marker weiss niemand, dass dort eine Tuer steht.
    """

    def setUp(self):
        self.mod = load_module()

    def test_a_door_leaf_gets_its_own_role(self):
        self.assertEqual(self.mod._stamm("wall-12-door"), "tuer")
        self.assertEqual(self.mod._stamm("garderobe-25"), "garderobe")
        self.assertIn("tuer", self.mod.NENNENSWERT)

    def test_a_door_leaf_is_never_folded_into_its_wall(self):
        """`wall-12-door` darf nicht ueber die 12 zu `wall-12` werden.

        Die Zusammenfassung sucht das erste rein numerische Segment. Bei einem
        Tuerblatt stuende danach die Wand auf der Karte statt der Tuer.
        """
        self.assertEqual(self.mod._bauteil("wall-12-door"), "wall-12-door")

    def test_wall_and_door_stay_two_markers(self):
        objekte = {"tuer": ["wall-12-door"], "garderobe": ["garderobe-25"]}
        lagen = {"wall-12-door": [0.24, 0.53], "garderobe-25": [0.24, 0.58]}
        marker = self.mod._marker_liste(objekte, lagen)
        self.assertEqual(len(marker), 2)
        self.assertEqual(sorted(m["name"] for m in marker),
                         ["garderobe-25", "wall-12-door"])

    def test_colour_separates_replace_from_keep(self):
        """Rot heisst ersetzen, blau heisst stehenlassen.

        Eine Karte, auf der alles gleich aussieht, beantwortet die Frage nicht,
        die sie beantworten soll.
        """
        objekte = {"tuer": ["wall-12-door"], "garderobe": ["garderobe-25"]}
        lagen = {"wall-12-door": [0.24, 0.53], "garderobe-25": [0.24, 0.58]}
        farben = {m["name"]: m["farbe"] for m in self.mod._marker_liste(objekte, lagen)}
        self.assertEqual(farben["garderobe-25"], "ersetzen")
        self.assertEqual(farben["wall-12-door"], "bleibt")


class MarkerListeTests(unittest.TestCase):
    def setUp(self):
        self.mod = load_module()
        self.objekte = {
            "garderobe": ["garderobe-25"],
            "stuff": ["stuff-20", "stuff-26"],
            "badewanne": ["badewanne-15"],
        }
        self.lagen = {
            "garderobe-25": [0.25, 0.60],
            "stuff-20": [0.40, 0.55],
            "stuff-26": [0.70, 0.30],
            "badewanne-15": [0.55, 0.70],
        }

    def test_numbers_are_unique_and_start_at_one(self):
        marker = self.mod._marker_liste(self.objekte, self.lagen)
        nummern = [m["n"] for m in marker]
        self.assertEqual(nummern, list(range(1, len(nummern) + 1)))

    def test_one_marker_per_piece_of_furniture_not_per_mesh(self):
        """Eine Dusche ist ein Marker, nicht sieben.

        In der .blend steht sie als `dusche_gross-16-tray`, `-glass-0`,
        `-rim-1` ... Sieben Kreise im Abstand weniger Zentimeter verdecken
        einander und lassen das Duschbad wichtiger aussehen als die
        Garderobe, um die es eigentlich geht.
        """
        objekte = {"dusche": ["dusche_gross-16-tray", "dusche_gross-16-glass-0",
                              "dusche_gross-16-rim-1", "dusche_gross-16-rim-2"]}
        lagen = {"dusche_gross-16-tray": [0.60, 0.64],
                 "dusche_gross-16-glass-0": [0.63, 0.71],
                 "dusche_gross-16-rim-1": [0.63, 0.67],
                 "dusche_gross-16-rim-2": [0.59, 0.63]}
        marker = self.mod._marker_liste(objekte, lagen)
        self.assertEqual(len(marker), 1)
        self.assertEqual(marker[0]["name"], "dusche_gross-16")
        self.assertEqual(marker[0]["teile"], 4)

    def test_groups_parts_whose_label_comes_before_the_number(self):
        """`kochfeld-ring-13--1--1` gehoert zu `kochfeld-13`.

        Die Teilbezeichnung steht nicht immer hinten. Wer stumpf nach den
        ersten zwei Segmenten schneidet, bekommt `kochfeld-13` und
        `kochfeld-ring` als zwei Marker uebereinander -- zwei Nummern auf
        demselben Kochfeld.
        """
        objekte = {"kochfeld": ["kochfeld-13", "kochfeld-ring-13--1--1",
                                "kochfeld-ring-13-1-1"]}
        lagen = {"kochfeld-13": [0.76, 0.49],
                 "kochfeld-ring-13--1--1": [0.761, 0.487],
                 "kochfeld-ring-13-1-1": [0.765, 0.495]}
        marker = self.mod._marker_liste(objekte, lagen)
        self.assertEqual([m["name"] for m in marker], ["kochfeld-13"])
        self.assertEqual(marker[0]["uv"], [0.76, 0.49])

    def test_places_a_grouped_marker_at_the_average_of_its_parts(self):
        """Ohne Hauptnetz zaehlt die Mitte der Teile, nicht das erste Teil.

        Das erste Teil ist alphabetisch bestimmt -- bei der Dusche eine
        Glasscheibe am Rand. Der Marker gehoert in die Mitte des Objekts.
        """
        objekte = {"dusche": ["dusche_gross-16-glass-0", "dusche_gross-16-glass-1"]}
        lagen = {"dusche_gross-16-glass-0": [0.40, 0.60],
                 "dusche_gross-16-glass-1": [0.60, 0.80]}
        marker = self.mod._marker_liste(objekte, lagen)
        self.assertEqual(marker[0]["uv"], [0.5, 0.7])

    def test_order_matches_the_order_of_the_markdown_list(self):
        """Die Karte und die Liste im Auftrag muessen dieselbe Reihenfolge haben.

        Sonst zeigt Marker 3 auf das Objekt, das im Text als 5 steht -- und
        die Karte richtet mehr Schaden an als das Raten vorher.
        """
        marker = self.mod._marker_liste(self.objekte, self.lagen)
        erwartet = []
        for stamm in sorted(self.objekte):
            erwartet.extend(self.objekte[stamm])
        self.assertEqual([m["name"] for m in marker], erwartet)

    def test_objects_without_a_position_get_no_marker(self):
        """Kein Marker ist ehrlicher als ein geratener.

        `stuff` wird als Flaeche gebaut und hat im Bauplan oft gar keine
        Punktposition. Ein Marker in der Bildmitte waere eine Erfindung.
        """
        lagen = dict(self.lagen)
        del lagen["stuff-26"]
        marker = self.mod._marker_liste(self.objekte, lagen)
        self.assertNotIn("stuff-26", [m["name"] for m in marker])
        self.assertEqual([m["n"] for m in marker], [1, 2, 3])

    def test_carries_the_role_so_the_list_can_be_read_without_the_map(self):
        marker = self.mod._marker_liste(self.objekte, self.lagen)
        rollen = {m["name"]: m["rolle"] for m in marker}
        self.assertEqual(rollen["garderobe-25"], self.mod.NENNENSWERT["garderobe"])
        self.assertEqual(rollen["badewanne-15"], self.mod.NENNENSWERT["badewanne"])


class InventarTests(unittest.TestCase):
    """Die Objektkarte schuetzt nur, was einen Marker hat.

    Am 2026-08-27 verschwand der Schreibtisch aus drei Bildern. Er traegt
    keinen Marker -- markiert sind nur Garderobe, Stuff, Sanitaer, Kueche und
    Tueren. Die Karte mit 30 Markern zu ueberladen macht sie unlesbar; also
    bekommt der Auftrag zusaetzlich eine vollstaendige Inventarliste, und
    Abschnitt 11 verlangt, dass jedes Stueck daraus im Bild vorkommt.
    """

    def setUp(self):
        self.mod = load_module()

    def test_counts_every_piece_of_furniture_by_kind(self):
        namen = ["doppelbett-1", "schreibtisch-3", "schreibtischstuhl-4",
                 "essgruppe_stuhl-9", "essgruppe_stuhl-10", "wall-5", "floor-2",
                 "cut-plane", "ground", "proto-7"]
        inv = self.mod._inventar(namen)
        self.assertEqual(inv["doppelbett"], 1)
        self.assertEqual(inv["essgruppe_stuhl"], 2)
        self.assertEqual(inv["schreibtisch"], 1)

    def test_counts_pieces_not_meshes(self):
        """Eine Dusche ist ein Stueck, nicht sieben.

        `dusche_gross-16` steht als tray, zwei Glasscheiben und vier Rahmen in
        der Datei. Wer Netze zaehlt, schreibt "dusche_gross x 7" in den Auftrag
        -- und Codex baut sieben Duschen oder haelt die Liste fuer unsinnig.
        """
        namen = ["dusche_gross-16-tray", "dusche_gross-16-glass-0",
                 "dusche_gross-16-glass-1", "dusche_gross-16-rim-1",
                 "dusche_gross-16-rim-2", "dusche_gross-16-rim-3",
                 "dusche_gross-16-rim-4"]
        self.assertEqual(self.mod._inventar(namen), {"dusche_gross": 1})

    def test_counts_each_id_once(self):
        """Drei Kleiderschraenke bleiben drei, auch mit Teilnetzen."""
        namen = ["kleiderschrank-5", "kleiderschrank-5-gap-1",
                 "kleiderschrank-8", "kleiderschrank-8-gap-1",
                 "kleiderschrank-8-gap-2", "kleiderschrank-11"]
        self.assertEqual(self.mod._inventar(namen), {"kleiderschrank": 3})

    def test_leaves_out_what_is_not_furniture(self):
        """Waende, Boeden, Schnittebene und Hilfsobjekte sind kein Inventar.

        Sie stehen zu Hunderten in der Datei und wuerden die Liste unbrauchbar
        machen.
        """
        inv = self.mod._inventar(["wall-5", "wall-5-door", "floor-2", "cut-plane",
                                  "ground", "proto-7", "sockel-wall-1"])
        self.assertEqual(inv, {})

    def test_lists_the_inventory_in_the_order(self):
        job = {
            "job_id": "haus-2026-08-27", "plan_id": "haus",
            "folder": r"E:\daten", "delivery_folder": r"E:\liefer",
            "source": {"annotation_hash": "abc123"},
            "inputs": [], "required_outputs": [],
            "constraints": {"models_locked": ".", "exterior_hero_shot": ".",
                            "interiors": ".", "naming": "."},
            "publish": {"command": ".", "note": "."},
            "inventar": {"doppelbett": 1, "schreibtisch": 1, "essgruppe_stuhl": 6},
        }
        text = self.mod.render_markdown(job)
        self.assertIn("Inventar", text)
        self.assertIn("schreibtisch", text)
        self.assertIn("essgruppe_stuhl", text)
        self.assertIn("6", text)


class MarkdownTests(unittest.TestCase):
    def setUp(self):
        self.mod = load_module()
        self.job = {
            "job_id": "haus-2026-08-27",
            "plan_id": "haus",
            "folder": r"E:\daten\haus\renders\go-baseline",
            "delivery_folder": r"E:\daten\haus\renders\codex-haus-2026-08-27",
            "source": {"annotation_hash": "abc123"},
            "inputs": [],
            "required_outputs": [],
            "constraints": {
                "models_locked": "Architektur ist unantastbar.",
                "exterior_hero_shot": "24-35 mm, Kamera waagerecht.",
                "interiors": "Vier Stile je Geschoss.",
                "naming": "Genau die Dateinamen aus Rueckgabe.",
            },
            "publish": {"command": "python publish-renders.py", "note": "."},
            "objects": {"garderobe": ["garderobe-25"], "stuff": ["stuff-20"]},
            "object_map": {
                "file": "OBJEKTKARTE-interior-modern-baseline.png",
                "image": [2000, 1500],
                "markers": [
                    {"n": 1, "name": "garderobe-25", "rolle": "Garderobe (ersetzen)",
                     "px": [500, 900]},
                    {"n": 2, "name": "stuff-20", "rolle": "Stuff (ersetzen)",
                     "px": [800, 825]},
                ],
            },
        }

    def test_every_marker_number_appears_exactly_once(self):
        text = self.mod.render_markdown(self.job)
        for marker in self.job["object_map"]["markers"]:
            self.assertEqual(text.count("**%d**" % marker["n"]), 1,
                             "Marker %d steht nicht genau einmal im Auftrag"
                             % marker["n"])

    def test_names_the_map_file_so_it_can_be_found(self):
        text = self.mod.render_markdown(self.job)
        self.assertIn(self.job["object_map"]["file"], text)

    def test_warns_about_the_open_door_leaf(self):
        """Die Falle beim Namen nennen, nicht nur die Karte danebenlegen.

        Genau dieser Irrtum hat zwei der vier Bilder gekostet.
        """
        text = self.mod.render_markdown(self.job)
        self.assertIn("Tuerblatt", text)

    def test_a_job_without_a_map_stays_valid(self):
        """Ohne Pillow oder ohne Baseline-Render gibt es keine Karte.

        Der Auftrag muss dann trotzdem vollstaendig sein -- ein Generator,
        der an einer fehlenden Zusatzbibliothek scheitert, blockiert die
        ganze Lieferkette.
        """
        job = dict(self.job)
        del job["object_map"]
        text = self.mod.render_markdown(job)
        self.assertIn("Objekte in dieser Datei", text)
        self.assertNotIn("OBJEKTKARTE", text)


class JedesMoebelBekommtEinenMarker(unittest.TestCase):
    """Nicht nur Platzhalter und Sanitaer -- alles, was im Raum steht.

    Rainer, 2026-08-28, nach der Lieferung fuer
    `german_catalog_review_bungalow_3_2_5_b_100_1`: "ja wir brauchen
    Ergebnisse."

    In jener Lieferung stand im Baseline-Render ein Schreibtisch mit
    Buerostuhl. Drei der vier Stile tauschten ihn aus: warm modern stellte ein
    Lowboard mit Fernseher hin, scandinavian ein Einzelbett, classic ein
    Sideboard. Nur dark modern liess den Schreibtisch stehen. Der
    `marker_check` meldete trotzdem 12 von 12 in Ordnung -- weil der
    Schreibtisch keinen Marker hatte.

    Die Karte trug bisher nur `garderobe`, `stuff`, Sanitaer, Kueche und
    Tueren. Der Kommentar an `_inventar` hielt schon am 2026-08-27 fest, dass
    der Schreibtisch aus drei Bildern verschwand, und entschied sich trotzdem
    fuer die kurze Karte plus eine Inventarliste. Die Liste hat es nicht
    verhindert.

    Wer nicht markiert ist, wird nicht geprueft.
    """

    def setUp(self):
        self.mod = load_module()

    def test_a_desk_gets_a_role(self):
        """Der Fall vom 2026-08-28."""
        self.assertTrue(self.mod.rolle_fuer("schreibtisch"))

    def test_every_piece_of_furniture_gets_a_role(self):
        for stamm in ("doppelbett", "einzelbett", "kleiderschrank", "lowboard",
                      "fernseher", "ecksofa", "essgruppe_6", "schreibtischstuhl",
                      "kuechenzeile", "waschmaschine", "trockner"):
            self.assertTrue(self.mod.rolle_fuer(stamm), stamm)

    def test_the_named_roles_keep_their_wording(self):
        """Sanitaer und Kueche behalten ihren scharfen Satz."""
        self.assertEqual(self.mod.rolle_fuer("dusche_gross"),
                         "Sanitaer (muss sichtbar bleiben)")
        self.assertEqual(self.mod.rolle_fuer("garderobe"), "Garderobe (ersetzen)")
        # Der Wortlaut von `stuff` wurde am 2026-09-01 mit Rainers
        # Zustimmung GESCHAERFT, nicht abgeschwaecht -- der Sinn dieses
        # Tests bleibt gewahrt. "Stuff (ersetzen)" sagte nicht, was daraus
        # werden soll, und Codex riet viermal verschieden (in 03 und 06 von
        # german_catalog_review_bungalow_3_3_4_b_100_2 blieb ein glatter
        # Kasten stehen, in 04 und 05 wurde eine Kuechenzeile daraus).
        #
        # Gepruefft wird weiter STRENG: die Marke `(ersetzen)` woertlich,
        # denn `farbe_fuer` sucht genau sie, und der scharfe Satz dazu.
        self.assertIn("(ersetzen)", self.mod.rolle_fuer("stuff"))
        self.assertIn("glatter Kasten ist kein Ergebnis",
                      self.mod.rolle_fuer("stuff"))

    def test_building_parts_get_none(self):
        """Waende, Boden, Dach und Treppen sind keine Moebel."""
        for stamm in ("wall", "floor", "roof", "stair", "loch", "sockel",
                      "window", "ceiling"):
            self.assertIsNone(self.mod.rolle_fuer(stamm), stamm)

    def test_only_placeholders_are_red(self):
        """Rot heisst ersetzen. Ein Schreibtisch wird umgestaltet, nicht ersetzt."""
        self.assertEqual(self.mod.farbe_fuer("garderobe"), "ersetzen")
        self.assertEqual(self.mod.farbe_fuer("stuff"), "ersetzen")
        for stamm in ("schreibtisch", "doppelbett", "dusche_gross", "tuer"):
            self.assertEqual(self.mod.farbe_fuer(stamm), "bleibt", stamm)


class EineKarteJeGeschoss(unittest.TestCase):
    """Ein zweigeschossiges Haus braucht zwei Objektkarten.

    Rainer, 2026-08-28: der Auftrag fuer `onehalfstorey_020` verlangte zehn
    Bilder -- vier aus dem Erd-, vier aus dem Obergeschoss und zwei
    Aussenansichten -- lieferte aber nur eine Karte, die des Erdgeschosses.
    Fuer die vier OG-Bilder gab es also nichts zu bestaetigen, und genau dort
    verschwand dreimal die Eckbadewanne, ohne dass eine Pruefung anschlug.

    `object_map` ist deshalb eine Liste. Auftraege von vorher tragen dort ein
    einzelnes Objekt; beide Leser muessen das aushalten, sonst faellt jede
    aeltere Lieferung durch.
    """

    def setUp(self):
        self.mod = load_module()

    def test_a_list_of_maps_stays_a_list(self):
        karten = [{"file": "OBJEKTKARTE-a.png", "markers": []},
                  {"file": "OBJEKTKARTE-b.png", "markers": []}]
        self.assertEqual(len(self.mod.karten_liste({"object_map": karten})), 2)

    def test_a_single_map_from_an_older_job_still_reads(self):
        karte = {"file": "OBJEKTKARTE-a.png", "markers": []}
        self.assertEqual(self.mod.karten_liste({"object_map": karte}), [karte])

    def test_a_job_without_a_map_gives_an_empty_list(self):
        self.assertEqual(self.mod.karten_liste({}), [])
        self.assertEqual(self.mod.karten_liste({"object_map": None}), [])

    def test_the_markdown_names_every_map(self):
        """Sonst legt Codex die zweite Karte nicht neben sein Bild."""
        job = _beispiel_job()
        job["object_map"] = [
            {"file": "OBJEKTKARTE-interior-modern-baseline.png",
             "image": [2000, 1500],
             "markers": [{"n": 1, "name": "garderobe-25", "rolle": "Garderobe (ersetzen)",
                          "px": [500, 900]}]},
            {"file": "OBJEKTKARTE-interior-modern-upper-baseline.png",
             "image": [2000, 1500],
             "markers": [{"n": 1, "name": "eckbadewanne-9",
                          "rolle": "Sanitaer (muss sichtbar bleiben)", "px": [700, 800]}]},
        ]
        text = self.mod.render_markdown(job)
        self.assertIn("OBJEKTKARTE-interior-modern-baseline.png", text)
        self.assertIn("OBJEKTKARTE-interior-modern-upper-baseline.png", text)
        self.assertIn("eckbadewanne-9", text)

    def test_each_map_numbers_from_one_again(self):
        """Die Nummern gehoeren zu ihrer Karte, nicht zum Haus.

        Sonst muesste Codex beim zweiten Geschoss bei 18 weiterzaehlen und
        jede Verwechslung waere unsichtbar.
        """
        job = _beispiel_job()
        job["object_map"] = [
            {"file": "OBJEKTKARTE-a.png", "image": [2000, 1500],
             "markers": [{"n": 1, "name": "garderobe-25", "rolle": "Garderobe (ersetzen)",
                          "px": [1, 1]}]},
            {"file": "OBJEKTKARTE-b.png", "image": [2000, 1500],
             "markers": [{"n": 1, "name": "eckbadewanne-9", "rolle": "Sanitaer",
                          "px": [2, 2]}]},
        ]
        text = self.mod.render_markdown(job)
        self.assertEqual(text.count("**1**"), 2)


class CodexLiefertEinmal(unittest.TestCase):
    """Kein zweiter Durchgang nur wegen der Dateinamen.

    Rainer, 2026-08-28: "das muss jetzt endlich vorbei sein." Zweimal in
    Folge hing eine sonst fehlerfreie Lieferung allein am Suffix, und beide
    Male kostete es eine ganze Runde bei Codex.

    Der Name zaehlt an genau einer Stelle -- `publish-renders.py` macht aus
    ihm den WordPress-Slug. `lieferung-pruefen.py --annehmen` schneidet ihn
    seit dem 2026-08-28 hier ab. Der Auftrag muss das sagen, sonst wartet
    Codex weiter auf eine Nachbestellung, die nicht mehr kommt.

    Erst hatte ich das Gegenteil eingebaut: einen Abschnitt, der Codex
    erklaerte, wie er einen Finalsatz erzeugt. Das war eine Runde mehr, nicht
    weniger.
    """

    def setUp(self):
        self.mod = load_module()
        self.text = self.mod.render_markdown(_beispiel_job())

    def test_the_order_says_codex_delivers_once(self):
        self.assertIn("Du lieferst einmal", self.text)

    def test_the_order_says_renaming_happens_here(self):
        self.assertIn("geforderten Namen gebracht", self.text)

    def test_the_order_forbids_re_rendering_an_accepted_image(self):
        """Das eine Wort, das die Badewanne rettet."""
        self.assertIn("nie neu rendern", self.text.lower())

    def test_the_order_no_longer_orders_a_final_set(self):
        """Der Abschnitt von heute Vormittag ist wieder raus."""
        self.assertNotIn("Finalsatz", self.text)
        # `-final` darf nur noch in der Verneinung vorkommen.
        self.assertIn("keine zweite Runde und keinen `-final`-Ordner", self.text)

    def test_the_order_still_allows_intermediate_names(self):
        """Zwischenstaende bleiben erlaubt -- sonst landen sie auf den
        geforderten Namen, bevor jemand sie gesehen hat."""
        self.assertIn("-review", self.text)


