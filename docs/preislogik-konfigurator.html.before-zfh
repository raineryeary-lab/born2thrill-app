const SATZ = { B: 2700, A: 2500, Z: 2650 };
const TYPNAME = { B: "Bungalow", A: "1,5-Geschosser", Z: "2-Geschosser / Doppelhaus" };
const FELDER = [["Einfamilienhaus", [4, 5]], ["Bungalow", [3, 4, 5]], ["Doppelhaus", [4, 5]], ["Zweifamilienhaus", [3, 4, 5]]];
const GRENZEN = [450000, 600000];
let heute = false;
const eur = (x) => Math.round(x / 1000).toLocaleString("de-DE") + ".000 €";
const spalte = (p) => p < GRENZEN[0] ? 0 : p < GRENZEN[1] ? 1 : 2;
const preis = (h, f) => heute ? h.h : h.m * 0.8 * SATZ[h.t] * f;

function zeichne() {
  const f = Number(document.getElementById("faktor").value);
  document.getElementById("faktorWert").textContent = heute ? "heute" : f.toFixed(2).replace(".", ",");
  document.querySelectorAll(".knopf").forEach((k) => k.setAttribute("aria-pressed",
    String(heute ? k.id === "heute" : !k.id && Number(k.dataset.f) === f)));
  document.getElementById("erklaerung").textContent = heute
    ? "Heute: 3.000 € je m² gezeichneter Fläche für jeden Haustyp, gleich viel über dem Markt wie etwa Faktor 1,4."
    : `Faktor ${f.toFixed(2).replace(".", ",")}: ${f === 1 ? "reiner Marktpreis" : `${Math.round((f - 1) * 100)} % über dem Markt`}.`;
  const zeilen = [];
  for (const [art, zimmer] of FELDER) {
    for (const z of zimmer) {
      const hs = DATEN.filter((h) => h.a === art && Math.min(Math.floor(h.z), 5) === z);
      const n = [0, 0, 0];
      hs.forEach((h) => n[spalte(preis(h, f))]++);
      zeilen.push(`<tr><td>${art}</td><td>${z}</td>` + n.map((c) =>
        `<td class="z${c === 0 ? " leer" : ""}" style="--a:${Math.min(c / 50, 1) * 0.4}"><span>${c}</span></td>`).join("") + "</tr>");
    }
  }
  document.getElementById("felder").innerHTML = zeilen.join("");
  document.getElementById("typen").innerHTML = ["B", "A", "Z"].map((t) => {
    const p = DATEN.filter((h) => h.t === t).map((h) => preis(h, f)).sort((a, b) => a - b);
    return `<tr><td>${TYPNAME[t]}</td><td>${p.length}</td><td>${eur(p[0])}</td><td>${eur(p[Math.floor(p.length / 2)])}</td><td>${eur(p[p.length - 1])}</td></tr>`;
  }).join("");
}
document.getElementById("faktor").addEventListener("input", () => { heute = false; zeichne(); });
document.querySelectorAll(".knopf[data-f]").forEach((k) => k.addEventListener("click", () => {
  heute = false; document.getElementById("faktor").value = k.dataset.f; zeichne(); }));
document.getElementById("heute").addEventListener("click", () => { heute = true; zeichne(); });
zeichne();
</script>
